---
import BaseLayout from '../layouts/BaseLayout.astro';
import MoviesFilter from '../components/MoviesFilter';
import StatGrid from '../components/StatGrid.astro';
import LoadError from '../components/LoadError.astro';
import { formatCalendarDate, maybeDate } from '../components/formatDate';
import { getLetterboxdData } from '../utils/letterboxd';

// Fetch Letterboxd data at build time
const letterboxdData = await getLetterboxdData();

// Use Letterboxd data if available
type Detail = { label: string; value: string };
const details = (...rows: Array<[string, string | number | undefined | false]>): Detail[] =>
  rows.filter(([, v]) => v !== undefined && v !== false && v !== '').map(([label, value]) => ({ label, value: String(value) }));

// Card details formatted at build time (Letterboxd diary dates are calendar dates)
const movies = (letterboxdData?.movies ?? []).map(movie => ({
    data: {
      title: movie.title,
      year: movie.year,
      releaseDate: movie.releaseDate,
      director: movie.director,
      posterImage: movie.posterImage,
      rating: movie.rating,
      rewatch: movie.rewatch,
      details: details(
        ['Director', movie.director],
        // the card subtitle is the director, or the year when there's no director
        ['Year', movie.director ? movie.year : undefined],
        ['Watched', maybeDate(movie.watchedDate) && formatCalendarDate(movie.watchedDate!, { year: 'numeric', month: 'short', day: 'numeric' })],
        ['Rewatch', movie.rewatch && 'Yes'],
        ['Rating', movie.rating ? `${movie.rating}/5` : undefined],
      ),
    }
  }));
---

<BaseLayout
  title="Movies - Atyansh Jaiswal"
  description="Movies I've watched"
>
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-4" style="color: var(--text-primary);">
        Movies
      </h1>
    </div>

    {movies.length > 0 && (
      <section class="mb-20">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-3xl font-bold" style="color: var(--text-primary);">
            My Film Diary
          </h2>
          <span class="text-sm" style="color: var(--text-secondary);">
            {movies.length} {movies.length === 1 ? 'film' : 'films'}
          </span>
        </div>

        {/* Only the fields the filter grid uses go into the island's props */}
        <MoviesFilter client:load movies={movies.map(({ data: { rewatch, ...data } }) => ({ data }))} />

        <StatGrid title="Viewing Stats" stats={[
          { value: movies.length, label: 'Total Films' },
          { value: movies.filter(m => m.data.rating && m.data.rating > 0).length, label: 'Rated' },
          { value: movies.filter(m => m.data.rating === 5).length, label: '5-Star Films' },
          { value: movies.filter(m => m.data.rewatch).length, label: 'Rewatches' },
        ]} />
      </section>
    )}

    {movies.length === 0 && (
      <LoadError thing="movie" />
    )}
  </div>
</BaseLayout>
