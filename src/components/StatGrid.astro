---
interface Stat {
  value: string | number;
  label: string;
}

interface Props {
  title: string;
  stats: Stat[];
}

const { title, stats } = Astro.props;

// Size the grid to the number of stats so 3 stats don't leave an empty 4th
// column (class names spelled out for Tailwind's scanner)
const columns: Record<number, string> = {
  1: 'grid-cols-1',
  2: 'grid-cols-2',
  3: 'grid-cols-3',
  4: 'grid-cols-2 md:grid-cols-4',
};
const gridCols = columns[stats.length] ?? 'grid-cols-2 md:grid-cols-4';
---

<div class="mt-8 p-6 rounded-lg" style="background-color: var(--bg-secondary);">
  <h3 class="text-lg font-semibold mb-3" style="color: var(--text-primary);">
    {title}
  </h3>
  <div class:list={['grid gap-4 text-center', gridCols]}>
    {stats.map(stat => (
      <div>
        <div class="text-3xl font-bold" style="color: var(--accent);">
          {stat.value}
        </div>
        <div class="text-sm" style="color: var(--text-secondary);">{stat.label}</div>
      </div>
    ))}
  </div>
</div>
