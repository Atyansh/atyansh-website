---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCarousel from '../components/GameCarousel';
import StatGrid from '../components/StatGrid.astro';
import { getAllGames } from '../utils/unified-games';

// Fetch all games and stats from all platforms in a single call
const { games: allGames, steamStats, psnStats, nintendoStats } = await getAllGames();

// Pre-compute platform game lists
const steamGames = allGames.filter(g => g.platform === 'steam');
const psnGames = allGames.filter(g => g.platform === 'psn');
const nintendoGames = allGames.filter(g => g.platform === 'nintendo');
---

<BaseLayout
  title="Games - Atyansh Jaiswal"
  description="Games I'm playing across Steam, PlayStation, and Nintendo Switch"
>
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-4" style="color: var(--text-primary);">
        Games
      </h1>
    </div>

    {allGames.length > 0 && (
      <section class="mb-20">
        {/* Steam Status Banner */}
        {steamStats && steamStats.playerSummary.gameextrainfo && (
          <div class="mb-8 p-6 rounded-lg border-2" style="background-color: var(--bg-secondary); border-color: var(--accent);">
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-full animate-pulse" style="background-color: var(--accent);"></div>
              <div>
                <div class="text-sm font-medium" style="color: var(--text-secondary);">Currently Playing on Steam</div>
                <div class="text-xl font-bold" style="color: var(--text-primary);">{steamStats.playerSummary.gameextrainfo}</div>
              </div>
            </div>
          </div>
        )}

        {/* Steam Games */}
        {steamStats && steamGames.length > 0 && (
          <div class="mb-12 p-6 rounded-lg" style="background-color: var(--bg-secondary);">
            <StatGrid title="Steam" stats={[
              { value: steamStats.totalGames, label: 'Total Games' },
              { value: `${steamStats.totalHoursPlayed.toLocaleString()}h`, label: 'Hours Played' },
              { value: steamStats.gamesPlayedCount, label: 'Games Played' },
            ]} />
            <div class="mt-6">
              <GameCarousel
                client:load
                games={steamGames}
                title="Recent Games"
              />
            </div>
          </div>
        )}

        {/* PlayStation Games */}
        {psnStats && psnGames.length > 0 && (
          <div class="mb-12 p-6 rounded-lg" style="background-color: var(--bg-secondary);">
            <StatGrid title="PlayStation" stats={[
              { value: psnStats.totalGames, label: 'Total Games' },
              ...(psnStats.trophyLevel ? [{ value: psnStats.trophyLevel, label: 'Trophy Level' }] : []),
              { value: psnStats.totalTrophies.total.toLocaleString(), label: 'Total Trophies' },
            ]} />

            {/* Trophy Breakdown */}
            {psnStats.totalTrophies.total > 0 && (
              <div class="mt-4 pt-4 border-t" style="border-color: var(--bg-primary);">
                <div class="flex flex-wrap gap-6 text-sm" style="color: var(--text-primary);">
                  {psnStats.totalTrophies.platinum > 0 && (
                    <div class="flex items-center gap-2">
                      <span>🏆 Platinum</span>
                      <span class="font-bold">{psnStats.totalTrophies.platinum}</span>
                    </div>
                  )}
                  {psnStats.totalTrophies.gold > 0 && (
                    <div class="flex items-center gap-2">
                      <span>🥇 Gold</span>
                      <span class="font-bold">{psnStats.totalTrophies.gold}</span>
                    </div>
                  )}
                  {psnStats.totalTrophies.silver > 0 && (
                    <div class="flex items-center gap-2">
                      <span>🥈 Silver</span>
                      <span class="font-bold">{psnStats.totalTrophies.silver}</span>
                    </div>
                  )}
                  {psnStats.totalTrophies.bronze > 0 && (
                    <div class="flex items-center gap-2">
                      <span>🥉 Bronze</span>
                      <span class="font-bold">{psnStats.totalTrophies.bronze}</span>
                    </div>
                  )}
                </div>
              </div>
            )}

            <div class="mt-6">
              <GameCarousel
                client:load
                games={psnGames}
                title="Recent Games"
              />
            </div>
          </div>
        )}

        {/* Nintendo Games */}
        {nintendoStats && nintendoGames.length > 0 && (
          <div class="mb-12 p-6 rounded-lg" style="background-color: var(--bg-secondary);">
            <StatGrid title="Nintendo Switch" stats={[
              { value: nintendoStats.totalGames, label: 'Total Games' },
              { value: `${nintendoStats.totalHoursPlayed.toLocaleString()}h`, label: 'Hours Played' },
            ]} />
            <div class="mt-6">
              <GameCarousel
                client:load
                games={nintendoGames}
                title="Recent Games"
              />
            </div>
          </div>
        )}
      </section>
    )}
  </div>
</BaseLayout>
