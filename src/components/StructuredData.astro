---
import { siteConfig } from '../site.config';

interface Props {
  type?: 'person' | 'article' | 'website' | 'blog';
  data?: Record<string, any>;
}

const { type = 'website', data = {} } = Astro.props;
const { author } = siteConfig;

const baseStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  url: siteConfig.url,
  image: author.avatar(400),
  jobTitle: author.jobTitle,
  ...(author.worksFor && {
    worksFor: {
      '@type': 'Organization',
      name: author.worksFor,
    },
  }),
  sameAs: siteConfig.social.filter(link => link.sameAs).map(link => link.url),
  ...(author.alumniOf && {
    alumniOf: {
      '@type': 'EducationalOrganization',
      name: author.alumniOf,
    },
  }),
};

const websiteData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.structuredDataDescription,
  author: {
    '@type': 'Person',
    name: author.name,
  },
};

const getStructuredData = () => {
  switch (type) {
    case 'person':
      return baseStructuredData;
    case 'website':
      return websiteData;
    case 'article':
      return {
        '@context': 'https://schema.org',
        '@type': 'Article',
        ...data,
        author: {
          '@type': 'Person',
          name: author.name,
          url: siteConfig.url,
        },
      };
    case 'blog':
      return {
        '@context': 'https://schema.org',
        '@type': 'Blog',
        ...data,
        author: {
          '@type': 'Person',
          name: author.name,
          url: siteConfig.url,
        },
      };
    default:
      return websiteData;
  }
};

const structuredData = getStructuredData();
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
