---
// In-site Spotify player: a single fixed bottom bar that plays whichever
// track tile ([data-spotify-track], rendered by MediaCard) the visitor
// clicks or taps, instead of sending them off to Spotify.
//
// It is a plain Spotify embed <iframe>; the src is swapped when another
// track is chosen. No Spotify JavaScript runs in our page (the iFrame API
// needs 'unsafe-eval'), so the only CSP allowance needed is
// frame-src https://open.spotify.com. The iframe is only created on the
// first click, so visitors who never press play load nothing from Spotify.
// Visitors may have to press play inside the embed; visitors not logged in
// to Spotify get 30-second previews, logged-in visitors get full tracks.
---

<div id="spotify-player" class="spotify-player" hidden>
  <section class="spotify-player-bar container mx-auto" aria-label="Spotify player">
    <div id="spotify-player-embed" class="spotify-player-embed"></div>
    <button
      id="spotify-player-close"
      type="button"
      class="spotify-player-close"
      aria-label="Close player"
      title="Close player"
    >
      <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </section>
  <p id="spotify-player-status" class="sr-only" aria-live="polite"></p>
</div>

<style>
  .spotify-player {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    padding: 0.5rem 1rem calc(0.5rem + env(safe-area-inset-bottom));
    /* --bg-secondary is opaque in every theme (--bg-card isn't in Modern Glass) */
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border);
    box-shadow: 0 -4px 16px var(--shadow);
  }

  .spotify-player[hidden] {
    display: none;
  }

  .spotify-player-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .spotify-player-embed {
    flex: 1;
    min-width: 0;
    height: 80px;
    border-radius: 12px;
    overflow: hidden;
    background-color: var(--bg-secondary);
  }

  .spotify-player-embed :global(iframe) {
    display: block;
    width: 100%;
    height: 80px;
    border: 0;
  }

  .spotify-player-close {
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    cursor: pointer;
  }

  .spotify-player-close:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Keep the page's last row reachable above the bar */
  :global(html.spotify-player-open body) {
    padding-bottom: calc(96px + env(safe-area-inset-bottom));
  }
</style>

<script>
  const EMBED_URL = 'https://open.spotify.com/embed/track/';

  let currentId: string | null = null;
  let lastTrigger: HTMLElement | null = null;

  const els = () => ({
    root: document.getElementById('spotify-player'),
    embed: document.getElementById('spotify-player-embed'),
    status: document.getElementById('spotify-player-status'),
  });

  function markPlaying(id: string | null) {
    document.querySelectorAll<HTMLElement>('[data-spotify-track][data-playing]').forEach((tile) => {
      delete tile.dataset.playing;
    });
    if (!id) return;
    document.querySelectorAll<HTMLElement>(`[data-spotify-track="${CSS.escape(id)}"]`).forEach((tile) => {
      tile.dataset.playing = '';
    });
  }

  function playTrack(tile: HTMLElement) {
    const { root, embed, status } = els();
    const id = tile.dataset.spotifyTrack;
    if (!root || !embed || !id) return;
    lastTrigger = tile;
    if (id === currentId && embed.querySelector('iframe')) return; // already loaded

    currentId = id;
    const title = tile.dataset.trackTitle ?? 'track';
    const by = tile.dataset.trackSubtitle ? ` by ${tile.dataset.trackSubtitle}` : '';

    let iframe = embed.querySelector('iframe');
    if (!iframe) {
      iframe = document.createElement('iframe');
      iframe.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
      iframe.loading = 'lazy';
      embed.appendChild(iframe);
    }
    iframe.title = `Spotify player: ${title}${by}`;
    iframe.src = `${EMBED_URL}${encodeURIComponent(id)}?utm_source=generator`;

    root.hidden = false;
    document.documentElement.classList.add('spotify-player-open');
    markPlaying(id);
    if (status) status.textContent = `Loaded in player: ${title}${by}`;
  }

  function closePlayer({ restoreFocus = true } = {}) {
    const { root, embed, status } = els();
    currentId = null;
    if (embed) embed.innerHTML = ''; // removing the iframe stops playback
    if (status) status.textContent = '';
    if (root) root.hidden = true;
    document.documentElement.classList.remove('spotify-player-open');
    markPlaying(null);
    if (restoreFocus && lastTrigger?.isConnected) lastTrigger.focus();
    lastTrigger = null;
  }

  // Delegated listeners on document, registered once: they work for tiles
  // in static HTML and inside hydrated islands, and survive page swaps.
  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (target?.closest('#spotify-player-close')) {
      closePlayer();
      return;
    }
    const tile = target?.closest<HTMLElement>('[data-spotify-track]');
    if (!tile) return;
    e.preventDefault();
    playTrack(tile);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && (e.target as Element | null)?.closest?.('#spotify-player')) {
      closePlayer();
    }
  });

  // Leaving the page removes the bar; reset state with it
  document.addEventListener('astro:before-swap', () => closePlayer({ restoreFocus: false }));
</script>
