const holdSnippet = `// Runs at the start of every server tick
void Game::loopReset() {
    gravityController_->deactivate();
    clearAnimations();

    for (auto pair : playerMap_) {
        pair.second->setVisible(true);
        pair.second->setLinearFactor(btVector3(1,1,1));
        pair.second->setBearMode(false);
    }
}`;
---

<BaseLayout
  title="Deerstalker - 3D Multiplayer Brawler"
  description="Four-player online brawler in C++ for UCSD CSE 125: hats grant abilities, Bullet physics runs on an authoritative server, clients render protobuf snapshots."
>
  <article class="max-w-6xl mx-auto">
    <!-- Hero Section -->
    <AnimatedCard delay={0}>
      <div class="text-center mb-12">
        <h1 class="text-5xl md:text-7xl font-bold mb-6" style="color: var(--accent);">
          Deerstalker
        </h1>
        <p class="text-xl md:text-2xl max-w-3xl mx-auto leading-relaxed" style="color: var(--text-secondary);">
          A four-player online brawler where you knock each other off a construction site, using hats that grant special abilities.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-wrap justify-center gap-4 mt-8">
          <a
            href="https://github.com/atyansh/deerstalker"
            target="_blank"
            rel="noopener noreferrer"
            class="action-button-primary inline-flex items-center gap-2 px-6 py-3 rounded-lg transition-colors font-medium text-base"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </a>
        </div>
      </div>
    </AnimatedCard>

    <!-- Project Stats -->
    <AnimatedCard delay={0.1}>
      <ProjectStats client:load stats={projectStats} />
    </AnimatedCard>

    <!-- About Section -->
    <AnimatedCard delay={0.2}>
      <div class="my-16 p-8 rounded-2xl" style="background: linear-gradient(135deg, rgba(var(--accent-rgb), 0.05) 0%, rgba(var(--accent-rgb), 0.02) 100%); border: 1px solid rgba(var(--accent-rgb), 0.1);">
        <h2 class="text-3xl md:text-4xl font-bold mb-6" style="color: var(--text-primary);">
          About the Project
        </h2>
        <div class="space-y-4 text-lg" style="color: var(--text-secondary);">
          <p>
            CSE 125 at UC San Diego is a ten-week capstone where a team builds a networked 3D game from scratch, with no
            game engine. Our team of seven was Team Deerstalker. The game went by "Rag Cage" on our team site and
            "Super Awesome Hat Attack Mania Wars" at the class showcase, and the pitch was simple: mysterious hats with great
            power have started showing up all over the world, so prove you're the true hat master in a last-one-standing brawl.
          </p>
          <p>
            Four players start on a construction-site stage with three lives each. Fall off and you lose a life; the last
            player with lives left wins. Hats drop onto the middle of the stage every ten seconds or so, and each one gives
            you two abilities for as long as you wear it. The idea started as a four-person "pseudo wrestling" game with
            rag-doll fighting, and the hats were the hook from the very first design doc.
          </p>
          <p>
            We split into a graphics and modeling sub-team and a networking and game-logic sub-team, and I was on the
            second. I wrote the server and the networking: the game loop, the protobuf protocol, the Bullet physics world, the character
            controller, all the combat and hat logic, the client's input and message handling, and the FMOD sound engine. By
            <code>git blame</code>, about 88% of the server code is mine. The rest of the team built the skeletal animation
            system and its ten character animations, the HUD and text rendering, the camera, skybox and cloud floor, and
            the art (modeling, rigging and animating the characters, the stage and five hats), and wrote server pieces I built on or merged: the first server skeleton, the config loader,
            item drops, respawning and shooting.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
            <div class="flex items-start gap-3">
              <span class="text-3xl">🎯</span>
              <div>
                <h4 class="font-bold" style="color: var(--text-primary);">Objective</h4>
                <p class="text-base">Knock the others off the stage; three lives each, last one standing wins</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-3xl">🎩</span>
              <div>
                <h4 class="font-bold" style="color: var(--text-primary);">Hats</h4>
                <p class="text-base">Five hats, each with a primary (RB) and a secondary (LB) ability</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-3xl">🌐</span>
              <div>
                <h4 class="font-bold" style="color: var(--text-primary);">Multiplayer</h4>
                <p class="text-base">Four clients over TCP; the match starts once all four press ready</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-3xl">⚡</span>
              <div>
                <h4 class="font-bold" style="color: var(--text-primary);">Physics</h4>
                <p class="text-base">One Bullet world on the server; clients only render what it sends</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </AnimatedCard>

    <!-- How It Works -->
    <AnimatedCard delay={0.3}>
      <div class="my-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center" style="color: var(--text-primary);">
          How It Works
        </h2>
        <div class="space-y-4 text-lg max-w-4xl mx-auto" style="color: var(--text-secondary);">
          <DeerstalkerDiagram variant="overview">
            Four clients, one authoritative server. Clients send what the player wants to do; the server decides what happens and tells everyone.
          </DeerstalkerDiagram>
          <p>
            <strong style="color: var(--text-primary);">The server owns everything.</strong> Clients never simulate anything.
            The server runs Boost.Asio on one thread to accept connections and read messages, and pushes every incoming message
            onto a mutex-protected queue. The main thread runs a fixed 30 Hz loop: drain the queue and apply each input event,
            step the Bullet world, expire mangoes and hats, update stun and respawn timers, then broadcast the result.
            Each tick advances Bullet by 1/15 s in four 1/60 s substeps, so the physics runs at double speed. We sped it up in week 8 because the game felt more natural that way.
          </p>
          <DeerstalkerDiagram variant="tick">
            The server's main loop. Input from all four players is applied before the physics step, so everyone's actions land in the same tick.
          </DeerstalkerDiagram>
          <p>
            <strong style="color: var(--text-primary);">What goes over the wire.</strong> Both directions use one protobuf
            <code>Message</code>, framed as a 6-character ASCII length followed by the serialized bytes, over TCP with Nagle's
            algorithm turned off. The header started at 4 digits and had to grow once snapshots passed 9,999 bytes. Clients send
            intents: a direction from the stick (8 directions, read digitally at a 0.5 tilt threshold) plus the camera's facing
            vector, or jump, punch, grab, equip, and the two hat buttons. Every tick the server answers with a full snapshot: for
            every player, hat and mango, its 4x4 world matrix as 16 doubles, plus each player's health, lives, current hat,
            animation state, visibility and hat timer. Alongside that come events for things clients should react to once:
            sounds, deletions, ready/start, win and game over.
          </p>
          <DeerstalkerDiagram variant="wire">
            One message type in both directions. Clients only ever send intent, and the server only ever sends the truth.
          </DeerstalkerDiagram>
          <p>
            <strong style="color: var(--text-primary);">The client is a renderer.</strong> A background Asio thread parses
            snapshots into a queue; the render loop drains it each frame, creates scene-graph nodes for new IDs, and sets each
            node's matrix straight from the server. There is no prediction or interpolation. The server also decides which
            animation each player is in, and the client keeps a preloaded skinned model per animation and just shows the right
            one. FMOD plays sound effects in 3D at the position of the player or object involved, with the listener on your own player.
          </p>
          <DeerstalkerDiagram variant="client">
            The client's screens and its frame loop. Once you're out of lives, the camera switches to another player until the match ends.
          </DeerstalkerDiagram>
          <p>
            <strong style="color: var(--text-primary);">Movement.</strong> Players are dynamic rigid bodies with rotation
            locked off, driven by a controller adapted from the dynamic character controller in Bullet's old demos. Each
            substep it casts a short ray down to decide whether you're on the ground and a few rays forward to find punch, ram
            and wrench targets. A move event turns you toward the camera-relative direction and applies a force; a jump is an
            upward impulse that only fires when the down ray hits something.
          </p>
          <p>
            <strong style="color: var(--text-primary);">Hold-to-use abilities with no state.</strong> At the start of every
            tick the server switches off zero gravity, invisibility and bear mode. The client sends a hat event every frame the
            bumper is held, which switches them back on. Holding the button keeps the ability on, and letting go ends it
            within one tick, without any timers or "is active" flags:
          </p>
          <pre class="p-4 rounded-xl overflow-x-auto text-sm" style="background: var(--card-bg); border: 1px solid rgba(var(--accent-rgb), 0.2);"><code>{holdSnippet}</code></pre>
        </div>
      </div>
    </AnimatedCard>

    <!-- Hats -->
    <AnimatedCard delay={0.4}>
      <div class="my-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center" style="color: var(--text-primary);">
          The Hats
        </h2>
        <p class="text-center text-lg mb-8 max-w-3xl mx-auto" style="color: var(--text-secondary);">
          Y picks up a hat within reach or throws yours away. A hat vanishes two minutes after it spawns, even on your head,
          and the HUD counts that down. When your health hits zero you're stunned for ten seconds and drop your hat.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 rounded-xl" style="background: var(--card-bg); border: 1px solid rgba(var(--accent-rgb), 0.2);">
            <h3 class="text-xl font-bold mb-3 flex items-center gap-2">
              <span style="color: var(--accent);">👊</span>
              <span style="color: var(--text-primary);">Bare hands (any time)</span>
            </h3>
            <p style="color: var(--text-secondary);">X punches: 10 damage and a knockback up and away. B grabs a stunned player within reach and carries them over your head; press B again to throw them.</p>
          </div>
          <div class="p-6 rounded-xl" style="background: var(--card-bg); border: 1px solid rgba(var(--accent-rgb), 0.2);">
            <h3 class="text-xl font-bold mb-3 flex items-center gap-2">
              <span style="color: var(--accent);">🧙</span>
              <span style="color: var(--text-primary);">Wizard hat</span>
            </h3>
            <p style="color: var(--text-secondary);"><strong>Primary:</strong> fire a mango that lives for two seconds. It does no damage, but it shoves whoever it hits.</p>
            <p style="color: var(--text-secondary);"><strong>Secondary:</strong> hold to heal.</p>
          </div>
          <div class="p-6 rounded-xl" style="background: var(--card-bg); border: 1px solid rgba(var(--accent-rgb), 0.2);">
            <h3 class="text-xl font-bold mb-3 flex items-center gap-2">
              <span style="color: var(--accent);">🚁</span>
              <span style="color: var(--text-primary);">Propeller hat</span>
            </h3>
            <p style="color: var(--text-secondary);"><strong>Primary:</strong> hold to fly up.</p>
            <p style="color: var(--text-secondary);"><strong>Secondary:</strong> hold to push yourself down.</p>
          </div>
          <div class="p-6 rounded-xl" style="background: var(--card-bg); border: 1px solid rgba(var(--accent-rgb), 0.2);">
            <h3 class="text-xl font-bold mb-3 flex items-center gap-2">
              <span style="color: var(--accent);">⛑️</span>
              <span style="color: var(--text-primary);">Hard hat</span>
            </h3>
            <p style="color: var(--text-secondary);"><strong>Primary:</strong> a long-reach wrench swing that does 100 damage, so a hit stuns at once.</p>
            <p style="color: var(--text-secondary);"><strong>Secondary:</strong> a ground slam. Players standing within range take 10 damage and are pushed outward; loose hats nearby scatter.</p>
          </div>
          <div class="p-6 rounded-xl" style="background: var(--card-bg); border: 1px solid rgba(var(--accent-rgb), 0.2);">
            <h3 class="text-xl font-bold mb-3 flex items-center gap-2">
              <span style="color: var(--accent);">🐻</span>
              <span style="color: var(--text-primary);">Bear hat</span>
            </h3>
            <p style="color: var(--text-secondary);"><strong>Primary:</strong> hold to switch off gravity for every player (you too) while different music plays.</p>
            <p style="color: var(--text-secondary);"><strong>Secondary:</strong> hold to turn into a bear. You're rooted in place and take no damage.</p>
          </div>
          <div class="p-6 rounded-xl" style="background: var(--card-bg); border: 1px solid rgba(var(--accent-rgb), 0.2);">
            <h3 class="text-xl font-bold mb-3 flex items-center gap-2">
              <span style="color: var(--accent);">🕵️</span>
              <span style="color: var(--text-primary);">Deerstalker</span>
            </h3>
            <p style="color: var(--text-secondary);"><strong>Primary:</strong> hold to be invisible to everyone else.</p>
            <p style="color: var(--text-secondary);"><strong>Secondary:</strong> charge forward as a giant ram. Three rays, straight ahead and 60° to each side, find the target, which takes 20 damage and a bigger knockback than a punch or wrench hit.</p>
          </div>
        </div>
      </div>
    </AnimatedCard>

    <!-- Video Showcase -->
    <AnimatedCard delay={0.5}>
      <div class="my-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center" style="color: var(--text-primary);">
          Development Progress Videos
        </h2>
        <VideoShowcase client:only="react" videos={videos} />
      </div>
    </AnimatedCard>

    <!-- Development Images -->
    <AnimatedCard delay={0.6}>
      <div class="my-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center" style="color: var(--text-primary);">
          Development Gallery
        </h2>
        <ImageGallery client:load images={developmentImages} />
      </div>
    </AnimatedCard>

    <!-- Tech Stack -->
    <AnimatedCard delay={0.7}>
      <div class="my-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center" style="color: var(--text-primary);">
          Technology Stack
        </h2>
        <TechStackGrid client:load technologies={techStack} />
      </div>
    </AnimatedCard>

    <!-- Development Journey -->
    <AnimatedCard delay={0.8}>
      <div class="my-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center" style="color: var(--text-primary);">
          Week by Week
        </h2>
        <p class="text-center text-lg mb-12 max-w-3xl mx-auto" style="color: var(--text-secondary);">
          My side of the project, from my weekly status reports and the commit log. The mood is the 1-10 morale score I gave each week.
        </p>
        <WeeklyTimeline client:load items={weeklyProgress} />
      </div>
    </AnimatedCard>

    <!-- Technical Challenges -->
    <AnimatedCard delay={0.9}>
      <div class="my-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center" style="color: var(--text-primary);">
          Problems I Ran Into
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 rounded-xl" style="background: var(--card-bg); border: 1px solid rgba(var(--accent-rgb), 0.2);">
            <h3 class="text-xl font-bold mb-3 flex items-center gap-2">
              <span style="color: var(--accent);">🎮</span>
              <span style="color: var(--text-primary);">Character controller</span>
            </h3>
            <p class="mb-2" style="color: var(--text-secondary);"><strong>Problem:</strong> Bullet's kinematic character controller has known issues, and it didn't work for us.</p>
            <p style="color: var(--text-secondary);"><strong>Fix:</strong> Players became ordinary rigid bodies with rotation locked, moved by forces, with ray casts for ground checks and attack targets.</p>
          </div>
          <div class="p-6 rounded-xl" style="background: var(--card-bg); border: 1px solid rgba(var(--accent-rgb), 0.2);">
            <h3 class="text-xl font-bold mb-3 flex items-center gap-2">
              <span style="color: var(--accent);">🌐</span>
              <span style="color: var(--text-primary);">Framing and latency</span>
            </h3>
            <p class="mb-2" style="color: var(--text-secondary);"><strong>Problem:</strong> The game's many small TCP messages didn't behave until Nagle's algorithm was off, and later the snapshots outgrew the 4-digit length header.</p>
            <p style="color: var(--text-secondary);"><strong>Fix:</strong> TCP_NODELAY on every server socket, a 6-digit header, and a 1 MB receive buffer.</p>
          </div>
          <div class="p-6 rounded-xl" style="background: var(--card-bg); border: 1px solid rgba(var(--accent-rgb), 0.2);">
            <h3 class="text-xl font-bold mb-3 flex items-center gap-2">
              <span style="color: var(--accent);">🧵</span>
              <span style="color: var(--text-primary);">Two threads, one game</span>
            </h3>
            <p class="mb-2" style="color: var(--text-secondary);"><strong>Problem:</strong> Network callbacks and the game loop run on different threads.</p>
            <p style="color: var(--text-secondary);"><strong>Fix:</strong> Callbacks only enqueue messages, and the game loop owns all game state, so the only locks are on the message queues.</p>
          </div>
          <div class="p-6 rounded-xl" style="background: var(--card-bg); border: 1px solid rgba(var(--accent-rgb), 0.2);">
            <h3 class="text-xl font-bold mb-3 flex items-center gap-2">
              <span style="color: var(--accent);">🤼</span>
              <span style="color: var(--text-primary);">Grabbing</span>
            </h3>
            <p class="mb-2" style="color: var(--text-secondary);"><strong>Problem:</strong> Carrying a player who is also a physics body.</p>
            <p style="color: var(--text-secondary);"><strong>Fix:</strong> The grabbed player's linear motion is zeroed out and each substep their transform is pinned above and behind the grabber, rotated to lie flat. Releasing them restores physics and launches them as a projectile in the direction the grabber is facing.</p>
          </div>
        </div>
      </div>
    </AnimatedCard>

    <!-- Team Lessons -->
    <AnimatedCard delay={1.0}>
      <div class="my-16 p-8 rounded-2xl" style="background: linear-gradient(135deg, rgba(var(--accent-rgb), 0.05) 0%, rgba(var(--accent-rgb), 0.02) 100%); border: 1px solid rgba(var(--accent-rgb), 0.1);">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center" style="color: var(--text-primary);">
          Looking Back
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex gap-4">
            <span class="text-3xl">💡</span>
            <div>
              <h4 class="font-bold text-lg mb-2" style="color: var(--text-primary);">Pin down gameplay early</h4>
              <p style="color: var(--text-secondary);">The hat brawler idea never changed, but the actual gameplay wasn't settled until late in the quarter, and most of the hat abilities went in during the final two weeks.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <span class="text-3xl">🔌</span>
            <div>
              <h4 class="font-bold text-lg mb-2" style="color: var(--text-primary);">Networking first</h4>
              <p style="color: var(--text-secondary);">My advice in our final report was to get networking working early and make sure client and server can talk correctly at scale. With the server-authoritative loop in place by week 3, most later features were server logic plus a new field or event in the protocol.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <span class="text-3xl">🎯</span>
            <div>
              <h4 class="font-bold text-lg mb-2" style="color: var(--text-primary);">Sub-teams worked</h4>
              <p style="color: var(--text-secondary);">Splitting into a networking/game-engine team and a graphics team let both move in parallel, with weekly meetings for the big decisions.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <span class="text-3xl">📚</span>
            <div>
              <h4 class="font-bold text-lg mb-2" style="color: var(--text-primary);">From scratch</h4>
              <p style="color: var(--text-secondary);">Building the engine ourselves is the point of the course, and I liked it: it's how you learn what a game engine actually does. For a game I just wanted to make, I'd reach for an engine like Unity and spend the time on gameplay instead.</p>
            </div>
          </div>
        </div>
      </div>
    </AnimatedCard>

    <!-- Footer -->
    <footer class="mt-12 mb-8">
      <a
        href="/work"
        class="accent-link inline-flex items-center gap-2 transition-colors font-medium text-lg"
        style="color: var(--accent);"
      >
