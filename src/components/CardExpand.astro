---
// Expand/collapse for info cards (MediaCard without a link: books, movies,
// TV, anime). Clicking or tapping a card's <button aria-expanded> shows its
// info panel (full title + details) over the card; a second click (on the
// card or the panel), Esc, or a click anywhere else collapses it. One card
// is open at a time. Styling: .media-card-wrap / .media-card-panel in
// global.css.
//
// One delegated listener pair on document, registered once per page load:
// works for cards inside React islands and survives View Transitions.
---

<script>
  function setExpanded(wrap: HTMLElement, expanded: boolean) {
    if (expanded) wrap.dataset.expanded = '';
    else delete wrap.dataset.expanded;
    wrap.querySelector('[data-expand-toggle]')?.setAttribute('aria-expanded', String(expanded));
  }

  function collapseAll(except?: HTMLElement | null) {
    document.querySelectorAll<HTMLElement>('.media-card-wrap[data-expanded]').forEach((wrap) => {
      if (wrap !== except) setExpanded(wrap, false);
    });
  }

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    const wrap = target?.closest<HTMLElement>('.media-card-wrap') ?? null;
    collapseAll(wrap);
    if (!wrap) return;

    if (target?.closest('.media-card-panel')) {
      setExpanded(wrap, false);
      wrap.querySelector<HTMLElement>('[data-expand-toggle]')?.focus({ preventScroll: true });
    } else if (target?.closest('[data-expand-toggle]')) {
      setExpanded(wrap, wrap.dataset.expanded === undefined);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = document.querySelector<HTMLElement>('.media-card-wrap[data-expanded]');
    if (!open) return;
    setExpanded(open, false);
    open.querySelector<HTMLElement>('[data-expand-toggle]')?.focus({ preventScroll: true });
  });
</script>
