---
import '../styles/global.css';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import StructuredData from '../components/StructuredData.astro';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  structuredDataType?: 'person' | 'article' | 'website' | 'blog';
  structuredData?: Record<string, any>;
}

const { title, description = "Software Engineer | Personal Website", image, type = "website", structuredDataType = "website", structuredData = {} } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Generate OG image URL
let ogImageURL: URL;
if (image) {
  ogImageURL = new URL(image, Astro.site);
} else {
  // Generate dynamic OG image
  const ogParams = new URLSearchParams({
    title: title.replace(' - Atyansh Jaiswal', '').replace(' - Blog', '').replace(' - Project', ''),
    description: description,
    type: type === 'article' ? 'blog' : 'default',
  });
  ogImageURL = new URL(`/og-image.png?${ogParams.toString()}`, Astro.site);
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Atyansh Jaiswal" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Security headers -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="geolocation=(), microphone=(), camera=()" />

    <!-- OpenGraph tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Atyansh Jaiswal" />

    <!-- Twitter Card tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@AtyanshJ" />
    <meta name="twitter:creator" content="@AtyanshJ" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- View Transitions for smooth page navigation -->
    <ViewTransitions />

    <script is:inline>
      // Run FIRST to set theme before ANY rendering
      (function() {
        const theme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = theme === 'dark' || (!theme && prefersDark);

        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <script>
      // Persist theme and data-theme across view transitions
      document.addEventListener('astro:before-swap', (e) => {
        // Preserve dark mode class
        const theme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = theme === 'dark' || (!theme && prefersDark);

        if (isDark) {
          e.newDocument.documentElement.classList.add('dark');
        } else {
          e.newDocument.documentElement.classList.remove('dark');
        }

        // Preserve data-theme attribute
        const savedTheme = localStorage.getItem('theme') || 'minimal-technical';
        e.newDocument.documentElement.setAttribute('data-theme', savedTheme);
      });

      // Suppress harmless WebSocket closed errors during View Transitions (dev only)
      if (import.meta.env.DEV) {
        const originalError = console.error;
        console.error = (...args) => {
          if (args[0]?.includes?.('WebSocket closed')) return;
          originalError.apply(console, args);
        };
      }
    </script>

    <!-- Structured Data -->
    <StructuredData type={structuredDataType} data={structuredData} />
  </head>
  <body class="min-h-screen flex flex-col" style="background-color: var(--bg-primary); color: var(--text-primary);">
    <!-- Skip to main content link for accessibility -->
    <a
      href="#main-content"
      class="skip-link sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 px-4 py-2 rounded-lg font-medium"
      style="background-color: var(--accent-surface); color: var(--accent-surface-fg); border: 2px solid var(--accent);"
    >
      Skip to main content
    </a>

    <header class="header-no-backdrop shadow-sm border-b" style="background-color: var(--bg-card); border-color: var(--border);" role="banner">
      <nav class="container mx-auto px-4 py-4" role="navigation" aria-label="Main navigation">
        <div class="flex items-center justify-between">
          <a href="/" class="accent-link text-2xl font-bold transition-colors rounded whitespace-nowrap" style="color: var(--accent); outline-color: var(--accent);" aria-label="Atyansh Jaiswal - Home">
            Atyansh Jaiswal
          </a>

          <!-- Desktop Navigation -->
          <div class="hidden lg:flex items-center gap-6">
            <ul class="flex items-center gap-5 text-sm font-medium" role="list">
              <li><a href="/" class="nav-link transition-colors rounded px-2 py-1" aria-label="Navigate to home page">Home</a></li>
              <li><a href="/work" class="nav-link transition-colors rounded px-2 py-1" aria-label="Navigate to projects page">Projects</a></li>

              <!-- Media Dropdown -->
              <li class="nav-dropdown relative">
                <button class="nav-dropdown-trigger transition-colors rounded px-2 py-1 flex items-center gap-1" aria-expanded="false" aria-haspopup="true">
                  Media
                  <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </button>
                <ul class="nav-dropdown-menu absolute left-0 top-full mt-1 py-2 rounded-lg shadow-lg border min-w-[140px] opacity-0 invisible transition-all duration-200 z-50" style="background-color: var(--bg-primary); border-color: var(--border);">
                  <li><a href="/books" class="nav-link block px-4 py-2 transition-colors">Books</a></li>
                  <li><a href="/music" class="nav-link block px-4 py-2 transition-colors">Music</a></li>
                  <li><a href="/movies" class="nav-link block px-4 py-2 transition-colors">Movies</a></li>
                  <li><a href="/tv" class="nav-link block px-4 py-2 transition-colors">TV</a></li>
                  <li><a href="/anime" class="nav-link block px-4 py-2 transition-colors">Anime</a></li>
                </ul>
              </li>

              <li><a href="/games" class="nav-link transition-colors rounded px-2 py-1" aria-label="Navigate to games page">Games</a></li>
              <li><a href="/climbing" class="nav-link transition-colors rounded px-2 py-1" aria-label="Navigate to climbing page">Climbing</a></li>
              <li><a href="/pets" class="nav-link transition-colors rounded px-2 py-1" aria-label="Navigate to pets page">Pets</a></li>
              <li><a href="/blog" class="nav-link transition-colors rounded px-2 py-1" aria-label="Navigate to blog">Blog</a></li>
            </ul>
          </div>

          <!-- Right Side: Theme Switcher and Mobile Menu Button -->
          <div class="flex items-center gap-4">
            <ThemeSwitcher />
            <button id="mobile-menu-button" class="p-2 lg:hidden" aria-label="Toggle menu">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile Navigation -->
        <div id="mobile-menu" class="hidden lg:hidden mt-4">
          <ul class="flex flex-col gap-1 text-sm font-medium" role="list">
            <li><a href="/" class="nav-link block transition-colors rounded px-2 py-2" aria-label="Navigate to home page">Home</a></li>
            <li><a href="/work" class="nav-link block transition-colors rounded px-2 py-2" aria-label="Navigate to projects page">Projects</a></li>
            <!-- Media section -->
            <li class="pt-2 pb-1 px-2 text-xs uppercase tracking-wider" style="color: var(--text-secondary);">Media</li>
            <li><a href="/books" class="nav-link block transition-colors rounded px-4 py-2" aria-label="Navigate to books page">Books</a></li>
            <li><a href="/music" class="nav-link block transition-colors rounded px-4 py-2" aria-label="Navigate to music page">Music</a></li>
            <li><a href="/movies" class="nav-link block transition-colors rounded px-4 py-2" aria-label="Navigate to movies page">Movies</a></li>
            <li><a href="/tv" class="nav-link block transition-colors rounded px-4 py-2" aria-label="Navigate to TV shows page">TV</a></li>
            <li><a href="/anime" class="nav-link block transition-colors rounded px-4 py-2" aria-label="Navigate to anime page">Anime</a></li>
            <!-- Other pages -->
            <li class="pt-2"><a href="/games" class="nav-link block transition-colors rounded px-2 py-2" aria-label="Navigate to games page">Games</a></li>
            <li><a href="/climbing" class="nav-link block transition-colors rounded px-2 py-2" aria-label="Navigate to climbing page">Climbing</a></li>
            <li><a href="/pets" class="nav-link block transition-colors rounded px-2 py-2" aria-label="Navigate to pets page">Pets</a></li>
            <li><a href="/blog" class="nav-link block transition-colors rounded px-2 py-2" aria-label="Navigate to blog">Blog</a></li>
          </ul>
        </div>
      </nav>
    </header>

    <script>
      function initMobileMenu() {
        const button = document.getElementById('mobile-menu-button');
        const menu = document.getElementById('mobile-menu');

        if (!button || !menu) return;

        button.addEventListener('click', () => {
          menu.classList.toggle('hidden');
        });
      }

      function initNavDropdowns() {
        const dropdowns = document.querySelectorAll('.nav-dropdown');

        dropdowns.forEach(dropdown => {
          const trigger = dropdown.querySelector('.nav-dropdown-trigger');
          const menu = dropdown.querySelector('.nav-dropdown-menu');
          const arrow = trigger?.querySelector('svg');

          if (!trigger || !menu) return;

          let timeoutId: ReturnType<typeof setTimeout> | null = null;

          const showMenu = () => {
            if (timeoutId) clearTimeout(timeoutId);
            menu.classList.remove('opacity-0', 'invisible');
            menu.classList.add('opacity-100', 'visible');
            trigger.setAttribute('aria-expanded', 'true');
            if (arrow) arrow.style.transform = 'rotate(180deg)';
          };

          const hideMenu = () => {
            timeoutId = setTimeout(() => {
              menu.classList.add('opacity-0', 'invisible');
              menu.classList.remove('opacity-100', 'visible');
              trigger.setAttribute('aria-expanded', 'false');
              if (arrow) arrow.style.transform = '';
            }, 150);
          };

          // Hover events
          dropdown.addEventListener('mouseenter', showMenu);
          dropdown.addEventListener('mouseleave', hideMenu);

          // Click for accessibility/touch
          trigger.addEventListener('click', (e) => {
            e.preventDefault();
            const isVisible = menu.classList.contains('visible');
            if (isVisible) {
              hideMenu();
            } else {
              showMenu();
            }
          });

          // Keyboard navigation
          trigger.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              const isVisible = menu.classList.contains('visible');
              if (isVisible) {
                hideMenu();
              } else {
                showMenu();
              }
            } else if (e.key === 'Escape') {
              hideMenu();
              trigger.focus();
            }
          });
        });

        // Close dropdowns when clicking outside
        document.addEventListener('click', (e) => {
          const target = e.target as Element;
          if (!target.closest('.nav-dropdown')) {
            document.querySelectorAll('.nav-dropdown-menu').forEach(menu => {
              menu.classList.add('opacity-0', 'invisible');
              menu.classList.remove('opacity-100', 'visible');
            });
            document.querySelectorAll('.nav-dropdown-trigger').forEach(trigger => {
              trigger.setAttribute('aria-expanded', 'false');
              const arrow = trigger.querySelector('svg');
              if (arrow) (arrow as HTMLElement).style.transform = '';
            });
          }
        });
      }

      // Initialize on page load
      initMobileMenu();
      initNavDropdowns();

      // Re-initialize after View Transitions
      document.addEventListener('astro:after-swap', () => {
        initMobileMenu();
        initNavDropdowns();
      });
    </script>

    <main id="main-content" class="flex-1 container mx-auto px-4 py-8" role="main">
      <slot />
    </main>

    <footer class="border-t py-8 mt-auto" style="background-color: var(--bg-card); border-color: var(--border);" role="contentinfo">
      <div class="container mx-auto px-4">
        <div class="flex justify-center items-center">
          <div class="text-sm" style="color: var(--text-secondary);">
            &copy; {new Date().getFullYear()} Atyansh Jaiswal
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
