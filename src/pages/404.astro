---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedCard from '../components/AnimatedCard';
---

<BaseLayout title="404 - Page Not Found" description="This page does not exist">
  <div class="max-w-3xl mx-auto text-center py-20">
    <AnimatedCard client:load delay={0}>
      <div class="py-12">
        <h1 class="text-9xl font-bold mb-4" style="color: var(--accent);">404</h1>
        <h2 class="text-3xl font-bold mb-6" style="color: var(--text-primary);">
          Page Not Found
        </h2>
        <p class="text-lg mb-8" style="color: var(--text-secondary);">
          Sorry, the page you're looking for doesn't exist or has been moved.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href="/"
            class="action-button-primary inline-flex items-center gap-2 px-6 py-3 text-white rounded-lg transition-colors font-medium"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            Go Home
          </a>

          <a
            href="/blog"
            class="action-button-secondary inline-flex items-center gap-2 px-6 py-3 border-2 rounded-lg transition-colors font-medium"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
            Read Blog
          </a>
        </div>

        <div class="mt-12 pt-8 border-t" style="border-color: var(--border);">
          <p class="text-sm mb-4" style="color: var(--text-secondary);">
            Looking for something specific? Here are some helpful links:
          </p>
          <div class="flex flex-wrap gap-3 justify-center">
            <a href="/work" class="text-sm hover:underline" style="color: var(--accent);">Work Experience</a>
            <span style="color: var(--text-secondary);">•</span>
            <a href="/projects" class="text-sm hover:underline" style="color: var(--accent);">Projects</a>
            <span style="color: var(--text-secondary);">•</span>
            <a href="/papers" class="text-sm hover:underline" style="color: var(--accent);">Papers</a>
            <span style="color: var(--text-secondary);">•</span>
            <a href="/interests" class="text-sm hover:underline" style="color: var(--accent);">Interests</a>
            <span style="color: var(--text-secondary);">•</span>
            <a href="/pgp" class="text-sm hover:underline" style="color: var(--accent);">PGP Key</a>
          </div>
        </div>
      </div>
    </AnimatedCard>
  </div>
</BaseLayout>
