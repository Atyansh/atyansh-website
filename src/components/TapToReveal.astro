---
// Touch-screen tap handling for media/game cards marked [data-tap-reveal].
// Phones can't hover, so the first tap on a card reveals its detail overlay
// ([data-expanded], styled in global.css); a second tap on a card that links
// somewhere follows the link, and on a card without a link it collapses the
// overlay again. Tapping elsewhere collapses any open card. Every tap does
// something visible — no dead taps. Mouse and keyboard are unaffected
// (hover / :focus-visible show the overlay there).
//
// One delegated listener on document, registered once per page load: it
// covers static cards and cards inside React islands alike, and survives
// View Transitions swaps without re-binding.
---

<script>
  const touchOnly = window.matchMedia('(hover: none)');

  document.addEventListener('click', (e) => {
    if (!touchOnly.matches) return;
    const card = (e.target as Element | null)?.closest<HTMLElement>('[data-tap-reveal]') ?? null;

    document.querySelectorAll<HTMLElement>('[data-tap-reveal][data-expanded]').forEach((open) => {
      if (open !== card) delete open.dataset.expanded;
    });
    if (!card) return;

    if (card.dataset.expanded === undefined) {
      card.dataset.expanded = '';
      e.preventDefault();
    } else if (!card.matches('a[href]')) {
      delete card.dataset.expanded;
    }
  });
</script>
