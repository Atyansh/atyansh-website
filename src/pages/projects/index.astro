---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf());
---

<BaseLayout title="Projects - Your Name" description="A collection of my security and privacy projects">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold mb-8 text-gray-900 dark:text-white">Projects</h1>

    <div class="grid md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <a
          href={`/projects/${project.slug}`}
          class="block p-6 bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg transition-shadow border border-gray-200 dark:border-gray-700"
        >
          <h2 class="text-2xl font-semibold mb-2 text-gray-900 dark:text-white">
            {project.data.title}
          </h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            {project.data.description}
          </p>
          {project.data.technologies && project.data.technologies.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-4">
              {project.data.technologies.map((tech) => (
                <span class="text-xs px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded">
                  {tech}
                </span>
              ))}
            </div>
          )}
          {project.data.links && (
            <div class="flex gap-3 text-sm">
              {project.data.links.github && (
                <span class="text-blue-600 dark:text-blue-400">GitHub →</span>
              )}
              {project.data.links.demo && (
                <span class="text-blue-600 dark:text-blue-400">Demo →</span>
              )}
              {project.data.links.website && (
                <span class="text-blue-600 dark:text-blue-400">Website →</span>
              )}
            </div>
          )}
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
