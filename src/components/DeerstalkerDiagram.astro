---
// System diagrams for the Deerstalker project page, drawn as inline SVG so
// they follow the site theme (text and lane colours come from the theme
// tokens; each subsystem keeps a fixed hue so the legend means the same
// thing in every diagram).
//
// Everything here was checked against the game's source
// (github.com/Atyansh/deerstalker): client/main.cpp, client/Window.cpp,
// server/Game.cpp, server/Server.cpp, util/Protos.proto.
interface Props {
  variant: 'overview' | 'tick' | 'wire' | 'client';
}
const { variant } = Astro.props;
const ah = `dz-ah-${variant}`;

type Cat = 'net' | 'logic' | 'phys' | 'gfx' | 'audio' | 'input' | 'shared';
interface Node {
  x: number; y: number; w: number; h: number;
  cat: Cat; tag?: string; title: string; sub?: string[];
}

const legend: { cat: Cat; label: string }[] = [
  { cat: 'input', label: 'Input' },
  { cat: 'net', label: 'Networking' },
  { cat: 'logic', label: 'Game logic' },
  { cat: 'phys', label: 'Physics' },
  { cat: 'gfx', label: 'Graphics' },
  { cat: 'audio', label: 'Audio' },
  { cat: 'shared', label: 'Shared code' },
];

// ---- 1. System overview ---------------------------------------------------
const overviewNodes: Node[] = [
  { x: 36, y: 84, w: 348, h: 64, cat: 'input', tag: 'INPUT', title: 'Controls', sub: ['Xbox controller via GLFW, or keyboard'] },
  { x: 36, y: 184, w: 348, h: 64, cat: 'net', tag: 'NETWORK THREAD', title: 'Boost.Asio reader', sub: ['parses each frame into a locked queue'] },
  { x: 36, y: 284, w: 348, h: 64, cat: 'logic', tag: 'MAIN THREAD', title: 'Message handler', sub: ['applies each snapshot to the scene'] },
  { x: 36, y: 384, w: 169, h: 64, cat: 'gfx', tag: 'GRAPHICS', title: 'OpenGL', sub: ['scene graph · GLSL'] },
  { x: 215, y: 384, w: 169, h: 64, cat: 'audio', tag: 'AUDIO', title: 'FMOD', sub: ['music · 3D effects'] },
  { x: 616, y: 84, w: 348, h: 164, cat: 'net', tag: 'NETWORK THREAD', title: 'Boost.Asio sessions', sub: ['one session per player', 'TCP_NODELAY, 1 MB receive buffer', 'incoming events go on a locked queue'] },
  { x: 616, y: 284, w: 348, h: 64, cat: 'logic', tag: 'MAIN THREAD · 30 HZ', title: 'Game loop', sub: ['all the rules: hats, combat, lives'] },
  { x: 616, y: 384, w: 348, h: 64, cat: 'phys', tag: 'PHYSICS', title: 'Bullet world', sub: ['rigid bodies, controllers, ray casts'] },
  { x: 16, y: 492, w: 968, h: 56, cat: 'shared', tag: 'SHARED UTIL LIBRARY (CLIENT + SERVER)', title: 'Protos.proto messages · length-prefixed framing · HatType enum · .ini config' },
];

// ---- 2. Server tick -------------------------------------------------------
const tickSteps: { cat: Cat; title: string; sub: string[] }[] = [
  { cat: 'logic', title: 'Reset', sub: ['switch off hold-to-use abilities:', 'zero gravity, invisibility, bear'] },
  { cat: 'net', title: 'Apply input', sub: ['drain the queue: move, jump,', 'punch, grab, equip, hats, ready'] },
  { cat: 'logic', title: 'Match flow', sub: ['start when all four are ready;', 'respawn anyone with lives left'] },
  { cat: 'phys', title: 'Simulate', sub: ['Bullet advances 1/15 s in four', '1/60 s substeps (double speed)'] },
  { cat: 'logic', title: 'Resolve', sub: ['expire mangoes and hats, stun', 'at zero health, revive the stunned'] },
  { cat: 'net', title: 'Broadcast', sub: ['a snapshot of every object, plus', 'queued events, to all four'] },
];
// Clockwise: 1-2-3 left to right on top, 4-5-6 right to left underneath.
const tickW = 300, tickGapX = 34, tickX0 = 16, tickH = 96, tickRowY = [40, 196];
const tickPos = (i: number) => i < 3
  ? { x: tickX0 + i * (tickW + tickGapX), y: tickRowY[0] }
  : { x: tickX0 + (5 - i) * (tickW + tickGapX), y: tickRowY[1] };

// ---- 3. Wire format -------------------------------------------------------
const upRows: [string, string][] = [
  ['MOVE', '8-way direction + camera facing'],
  ['JUMP · PUNCH · GRAB', 'one-shot actions'],
  ['EQUIP', 'pick up or throw away a hat'],
  ['HATR · HATL', 'hat abilities, sent while held'],
  ['READY', 'from the lobby'],
];
const downRows: [string, string][] = [
  ['GameObject × N', 'every player, hat and mango'],
  ['  matrix', '4×4 world transform, 16 doubles'],
  ['  state', 'health, lives, hat, timer'],
  ['  animation', 'which of 13 animations to show'],
  ['Events', 'player ID, ready, start, sounds,'],
  ['', 'music, win, game over'],
];

// ---- 4. Client ------------------------------------------------------------
const screens = ['Loading', 'Title', 'Lobby', 'Ready', 'Match', 'Spectating'];
const screenCats: Cat[] = ['shared', 'shared', 'shared', 'shared', 'logic', 'logic'];
const transitions = [
  ['assets', 'loaded'],
  ['press', 'Start'],
  ['press A,', 'sends READY'],
  ['server sends', 'START_GAME'],
  ['out of', 'lives'],
];
const pillW = 120, pillGap = 44, pillX0 = 30, pillY = 52, pillH = 46;
const frameSteps: { cat: Cat; title: string; sub: string[] }[] = [
  { cat: 'input', title: 'Read input', sub: ['gamepad + keys become', 'protobuf events, sent', 'straight to the server'] },
  { cat: 'audio', title: 'Update audio', sub: ['FMOD tick: music for', 'the screen, 3D effects', 'heard from your player'] },
  { cat: 'gfx', title: 'Draw', sub: ['scene graph, skinned', 'models, skybox, clouds,', 'HUD; camera follows you'] },
  { cat: 'logic', title: 'Handle messages', sub: ['drain the snapshot', 'queue and update', 'every node’s matrix'] },
];
const fW = 210, fGap = 32, fX0 = 30, fY = 182, fH = 116;
---

<figure class="dz not-prose">
  <div class="dz-scroll">
    {variant === 'overview' && (
      <svg viewBox="0 0 1000 600" role="img" aria-labelledby="dz-overview-title">
        <title id="dz-overview-title">Deerstalker system architecture: four clients talk to one authoritative server over TCP</title>
        <defs>
          <marker id={ah} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto-start-reverse"><path d="M0,0 L8,4 L0,8 z" class="dz-arrowhead" /></marker>
        </defs>
        <rect x="16" y="40" width="388" height="428" rx="16" class="dz-lane" />
        <text x="36" y="66" class="dz-lane-label">CLIENT · ONE PER PLAYER, ×4</text>
        <rect x="596" y="40" width="388" height="428" rx="16" class="dz-lane" />
        <text x="616" y="66" class="dz-lane-label">SERVER · AUTHORITATIVE</text>

        <rect x="420" y="84" width="160" height="164" rx="12" class="dz-wire" />
        <text x="500" y="158" class="dz-wire-title">TCP</text>
        <text x="500" y="176" class="dz-small" text-anchor="middle">length-prefixed</text>
        <text x="500" y="190" class="dz-small" text-anchor="middle">protobuf frames</text>

        {overviewNodes.map((n) => (
          <g class={`dz-node dz-${n.cat}`}>
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="10" />
            {n.tag && <text x={n.x + 14} y={n.y + 20} class="dz-tag">{n.tag}</text>}
            <text x={n.x + 14} y={n.y + (n.tag ? 40 : 24)} class="dz-title">{n.title}</text>
            {n.sub?.map((s, i) => <text x={n.x + 14} y={n.y + 57 + i * 17} class="dz-sub">{s}</text>)}
          </g>
        ))}

        <!-- client → server -->
        <line x1="384" y1="116" x2="610" y2="116" class="dz-edge" marker-end={`url(#${ah})`} />
        <text x="500" y="108" class="dz-edge-label" text-anchor="middle">input events</text>
        <!-- server → client -->
        <line x1="616" y1="216" x2="390" y2="216" class="dz-edge" marker-end={`url(#${ah})`} />
        <text x="500" y="236" class="dz-edge-label" text-anchor="middle">snapshot + events</text>

        <!-- client internals -->
        <line x1="210" y1="248" x2="210" y2="278" class="dz-edge" marker-end={`url(#${ah})`} />
        <line x1="120" y1="348" x2="120" y2="378" class="dz-edge" marker-end={`url(#${ah})`} />
        <line x1="300" y1="348" x2="300" y2="378" class="dz-edge" marker-end={`url(#${ah})`} />

        <!-- server internals -->
        <line x1="740" y1="248" x2="740" y2="278" class="dz-edge" marker-end={`url(#${ah})`} />
        <text x="732" y="268" class="dz-edge-label" text-anchor="end">queued input</text>
        <line x1="860" y1="284" x2="860" y2="254" class="dz-edge" marker-end={`url(#${ah})`} />
        <text x="868" y="268" class="dz-edge-label">broadcast</text>
        <line x1="790" y1="348" x2="790" y2="378" class="dz-edge" marker-start={`url(#${ah})`} marker-end={`url(#${ah})`} />
        <text x="800" y="368" class="dz-edge-label">step · read transforms</text>

        <g transform="translate(16 580)">
          {legend.map((l, i) => (
            <g class={`dz-node dz-${l.cat}`} transform={`translate(${i * 138} 0)`}>
              <rect x="0" y="-11" width="14" height="14" rx="4" />
              <text x="22" y="1" class="dz-legend">{l.label}</text>
            </g>
          ))}
        </g>
      </svg>
    )}

    {variant === 'tick' && (
      <svg viewBox="0 0 1000 310" role="img" aria-labelledby="dz-tick-title">
        <title id="dz-tick-title">One server tick: reset, apply input, match flow, simulate, resolve, broadcast; repeated 30 times a second</title>
        <defs>
          <marker id={ah} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto-start-reverse"><path d="M0,0 L8,4 L0,8 z" class="dz-arrowhead" /></marker>
        </defs>
        <text x="16" y="24" class="dz-lane-label">ONE SERVER TICK · EVERY 33 MS</text>
        {tickSteps.map((s, i) => {
          const { x, y } = tickPos(i);
          return (
            <g class={`dz-node dz-${s.cat}`}>
              <rect x={x} y={y} width={tickW} height={tickH} rx="12" />
              <circle cx={x + 26} cy={y + 28} r="13" class="dz-badge" />
              <text x={x + 26} y={y + 33} class="dz-badge-text">{i + 1}</text>
              <text x={x + 50} y={y + 33} class="dz-title">{s.title}</text>
              {s.sub.map((t, j) => <text x={x + 16} y={y + 62 + j * 17} class="dz-sub">{t}</text>)}
            </g>
          );
        })}
        {/* 1→2, 2→3 */}
        {[0, 1].map((i) => {
          const a = tickPos(i);
          return <line x1={a.x + tickW + 2} y1={a.y + tickH / 2} x2={a.x + tickW + tickGapX - 4} y2={a.y + tickH / 2} class="dz-edge" marker-end={`url(#${ah})`} />;
        })}
        {/* 3↓4 */}
        <line x1={tickPos(2).x + tickW / 2} y1={tickRowY[0] + tickH + 2} x2={tickPos(2).x + tickW / 2} y2={tickRowY[1] - 4} class="dz-edge" marker-end={`url(#${ah})`} />
        {/* 4→5, 5→6 (right to left) */}
        {[3, 4].map((i) => {
          const a = tickPos(i);
          return <line x1={a.x - 2} y1={a.y + tickH / 2} x2={a.x - tickGapX + 4} y2={a.y + tickH / 2} class="dz-edge" marker-end={`url(#${ah})`} />;
        })}
        {/* 6↑1: next tick */}
        <line x1={tickPos(5).x + tickW / 2} y1={tickRowY[1] - 2} x2={tickPos(0).x + tickW / 2} y2={tickRowY[0] + tickH + 4} class="dz-edge dz-loop" marker-end={`url(#${ah})`} />
        <rect x="250" y="155" width="500" height="26" rx="13" class="dz-pill-bg" />
        <text x="500" y="172" class="dz-edge-label" text-anchor="middle">sleep out the rest of the 33 ms, then again · a new hat every 10 s</text>
      </svg>
    )}

    {variant === 'wire' && (
      <svg viewBox="0 0 1000 420" role="img" aria-labelledby="dz-wire-title">
        <title id="dz-wire-title">Message format: a 6-digit length header followed by a protobuf Message; what clients send and what the server sends back</title>
        <defs>
          <marker id={ah} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto-start-reverse"><path d="M0,0 L8,4 L0,8 z" class="dz-arrowhead" /></marker>
        </defs>
        <text x="16" y="24" class="dz-lane-label">EVERY MESSAGE, IN BOTH DIRECTIONS</text>
        {[' ', ' ', '1', '3', '4', '2'].map((d, i) => (
          <g class="dz-node dz-net">
            <rect x={16 + i * 35} y="38" width="31" height="58" rx="8" />
            <text x={31.5 + i * 35} y="74" class="dz-mono" text-anchor="middle">{d === ' ' ? '␣' : d}</text>
          </g>
        ))}
        <g class="dz-node dz-shared">
          <rect x="232" y="38" width="752" height="58" rx="10" />
          <text x="608" y="74" class="dz-mono" text-anchor="middle">protobuf Message {'{'} messageType, event[], gameObject[] {'}'}</text>
        </g>
        <text x="119" y="116" class="dz-small" text-anchor="middle">6 ASCII digits: body length</text>
        <text x="608" y="116" class="dz-small" text-anchor="middle">serialized bytes</text>

        <g class="dz-node dz-input">
          <rect x="16" y="150" width="440" height="250" rx="14" />
          <text x="36" y="180" class="dz-tag">CLIENT → SERVER</text>
          <text x="36" y="202" class="dz-title">When you press something</text>
          {upRows.map(([k, v], i) => (
            <g>
              <text x="36" y={236 + i * 30} class="dz-key">{k}</text>
              <text x="214" y={236 + i * 30} class="dz-sub">{v}</text>
            </g>
          ))}
        </g>
        <g class="dz-node dz-net">
          <rect x="544" y="150" width="440" height="250" rx="14" />
          <text x="564" y="180" class="dz-tag">SERVER → CLIENT</text>
          <text x="564" y="202" class="dz-title">Every tick, 30 times a second</text>
          {downRows.map(([k, v], i) => (
            <g>
              <text x="564" y={236 + i * 27} class="dz-key">{k}</text>
              <text x="712" y={236 + i * 27} class="dz-sub">{v}</text>
            </g>
          ))}
        </g>
        <line x1="462" y1="250" x2="536" y2="250" class="dz-edge" marker-end={`url(#${ah})`} />
        <text x="500" y="240" class="dz-edge-label" text-anchor="middle">intent</text>
        <line x1="538" y1="310" x2="464" y2="310" class="dz-edge" marker-end={`url(#${ah})`} />
        <text x="500" y="300" class="dz-edge-label" text-anchor="middle">truth</text>
      </svg>
    )}

    {variant === 'client' && (
      <svg viewBox="0 0 1000 330" role="img" aria-labelledby="dz-client-title">
        <title id="dz-client-title">Client screens from loading to spectating, and the four steps the client runs every frame</title>
        <defs>
          <marker id={ah} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto-start-reverse"><path d="M0,0 L8,4 L0,8 z" class="dz-arrowhead" /></marker>
        </defs>
        <text x="16" y="24" class="dz-lane-label">SCREENS</text>
        {screens.map((s, i) => {
          const x = pillX0 + i * (pillW + pillGap);
          return (
            <g class={`dz-node dz-${screenCats[i]}`}>
              <rect x={x} y={pillY} width={pillW} height={pillH} rx={pillH / 2} />
              <text x={x + pillW / 2} y={pillY + 29} class="dz-title" text-anchor="middle">{s}</text>
            </g>
          );
        })}
        {transitions.map((t, i) => {
          const x = pillX0 + i * (pillW + pillGap) + pillW;
          const mid = x + pillGap / 2;
          return (
            <g>
              <line x1={x + 2} y1={pillY + pillH / 2} x2={x + pillGap - 4} y2={pillY + pillH / 2} class="dz-edge" marker-end={`url(#${ah})`} />
              <text x={mid} y={pillY + pillH + 22} class="dz-small" text-anchor="middle">{t[0]}</text>
              <text x={mid} y={pillY + pillH + 36} class="dz-small" text-anchor="middle">{t[1]}</text>
            </g>
          );
        })}
        <!-- game over: Match and Spectating both return to the lobby -->
        <path d={`M ${pillX0 + 5 * (pillW + pillGap) + pillW / 2} ${pillY} V 36 H ${pillX0 + 2 * (pillW + pillGap) + pillW / 2} V ${pillY - 4}`} class="dz-edge dz-loop" marker-end={`url(#${ah})`} />
        <line x1={pillX0 + 4 * (pillW + pillGap) + pillW / 2} y1={pillY} x2={pillX0 + 4 * (pillW + pillGap) + pillW / 2} y2="36" class="dz-edge dz-loop" />
        <rect x="500" y="25" width="190" height="22" rx="11" class="dz-pill-bg" />
        <text x="595" y="40" class="dz-edge-label" text-anchor="middle">game over → back to lobby</text>

        <text x="16" y="168" class="dz-lane-label">EVERY FRAME, ON THE MAIN THREAD</text>
        {frameSteps.map((s, i) => {
          const x = fX0 + i * (fW + fGap);
          return (
            <g class={`dz-node dz-${s.cat}`}>
              <rect x={x} y={fY} width={fW} height={fH} rx="12" />
              <circle cx={x + 24} cy={fY + 26} r="13" class="dz-badge" />
              <text x={x + 24} y={fY + 31} class="dz-badge-text">{i + 1}</text>
              <text x={x + 46} y={fY + 31} class="dz-title">{s.title}</text>
              {s.sub.map((t, j) => <text x={x + 14} y={fY + 62 + j * 17} class="dz-sub">{t}</text>)}
            </g>
          );
        })}
        {frameSteps.slice(0, -1).map((_, i) => {
          const x = fX0 + i * (fW + fGap) + fW;
          return <line x1={x + 2} y1={fY + fH / 2} x2={x + fGap - 4} y2={fY + fH / 2} class="dz-edge" marker-end={`url(#${ah})`} />;
        })}
        <path d={`M ${fX0 + 3 * (fW + fGap) + fW} ${fY + fH / 2} H ${fX0 + 3 * (fW + fGap) + fW + 14} V ${fY + fH + 18} H ${fX0 - 14} V ${fY + fH / 2} H ${fX0 - 4}`} class="dz-edge dz-loop" marker-end={`url(#${ah})`} />
      </svg>
    )}
  </div>
  <figcaption><slot /></figcaption>
</figure>

<style>
  .dz {
    margin: 2rem 0;
    --c-input: #22c55e;
    --c-net: #3b82f6;
    --c-logic: #14b8a6;
    --c-phys: #f59e0b;
    --c-gfx: #8b5cf6;
    --c-audio: #ec4899;
    --c-shared: #64748b;
  }
  .dz-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  svg {
    display: block;
    width: 100%;
    min-width: 720px;
    height: auto;
    font-family: var(--font-secondary, system-ui, sans-serif);
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    text-align: center;
    color: var(--text-secondary);
  }
  figcaption:empty { display: none; }

  .dz-input { --c: var(--c-input); }
  .dz-net { --c: var(--c-net); }
  .dz-logic { --c: var(--c-logic); }
  .dz-phys { --c: var(--c-phys); }
  .dz-gfx { --c: var(--c-gfx); }
  .dz-audio { --c: var(--c-audio); }
  .dz-shared { --c: var(--c-shared); }

  .dz-lane {
    fill: var(--bg-secondary);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .dz-lane-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    fill: var(--text-secondary);
  }
  .dz-wire {
    fill: none;
    stroke: var(--text-secondary);
    stroke-width: 1.5;
    stroke-dasharray: 6 5;
    opacity: 0.7;
  }
  .dz-wire-title {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.12em;
    fill: var(--text-primary);
    text-anchor: middle;
  }
  .dz-node rect {
    fill: color-mix(in srgb, var(--c) 13%, transparent);
    stroke: color-mix(in srgb, var(--c) 75%, transparent);
    stroke-width: 1.5;
  }
  .dz-tag {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.09em;
    fill: var(--c);
  }
  .dz-title {
    font-size: 15px;
    font-weight: 650;
    fill: var(--text-primary);
  }
  .dz-sub, .dz-small, .dz-edge-label, .dz-legend {
    fill: var(--text-secondary);
  }
  .dz-sub { font-size: 12.5px; }
  .dz-small { font-size: 11.5px; }
  .dz-legend { font-size: 12.5px; }
  .dz-edge-label { font-size: 12px; font-style: italic; }
  .dz-key {
    font-family: var(--font-primary, ui-monospace, monospace);
    font-size: 12.5px;
    font-weight: 600;
    fill: var(--text-primary);
    white-space: pre;
  }
  .dz-mono {
    font-family: var(--font-primary, ui-monospace, monospace);
    font-size: 15px;
    font-weight: 600;
    fill: var(--text-primary);
    white-space: pre;
  }
  .dz-edge {
    stroke: var(--text-secondary);
    stroke-width: 1.75;
    fill: none;
  }
  .dz-loop { stroke-dasharray: 5 4; }
  .dz-arrowhead { fill: var(--text-secondary); }
  .dz-pill-bg {
    fill: var(--bg-card, var(--bg-primary));
    stroke: var(--border);
  }
  .dz-badge {
    fill: var(--c);
  }
  .dz-badge-text {
    font-size: 13px;
    font-weight: 800;
    fill: #fff;
    text-anchor: middle;
  }
</style>
