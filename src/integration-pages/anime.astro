---
import { pageTitle } from '../site.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimeFilter from '../components/AnimeFilter';
import StatGrid from '../components/StatGrid.astro';
import LoadError from '../components/LoadError.astro';
import { formatCalendarDate, maybeDate } from '../components/formatDate';
import { getMALData } from '../utils/myanimelist';

// Fetch MyAnimeList data at build time
const malData = await getMALData();

// Use MAL data if available
type Detail = { label: string; value: string };
const details = (...rows: Array<[string, string | number | undefined | false]>): Detail[] =>
  rows.filter(([, v]) => v !== undefined && v !== false && v !== '').map(([label, value]) => ({ label, value: String(value) }));
const STATUS_LABELS: Record<string, string> = { watching: 'Watching', completed: 'Completed', on_hold: 'On hold', dropped: 'Dropped', plan_to_watch: 'Plan to watch' };
const airDate = (d?: Date | string) => (maybeDate(d) ? formatCalendarDate(d!, { year: 'numeric', month: 'short' }) : undefined);

// Card details formatted at build time (MAL air dates are calendar dates)
const anime = (malData?.anime ?? [])
    .map(a => ({
      data: {
        title: a.title,
        englishTitle: a.englishTitle,
        imageUrl: a.imageUrl,
        score: a.score,
        status: a.status,
        type: a.type,
        year: a.year,
        startDate: a.startDate,
        malUrl: a.malUrl,
        details: details(
          ['English title', a.englishTitle && a.englishTitle !== a.title ? a.englishTitle : undefined],
          ['Status', STATUS_LABELS[a.status] ?? a.status],
          ['Episodes', a.episodes ? (a.episodesWatched ? `${a.episodesWatched} / ${a.episodes}` : `${a.episodes}`) : undefined],
          ['Aired', airDate(a.startDate) && (airDate(a.endDate) && airDate(a.endDate) !== airDate(a.startDate) ? `${airDate(a.startDate)} – ${airDate(a.endDate)}` : airDate(a.startDate))],
          ['Score', a.score ? `${a.score}/10` : undefined],
        ),
      }
    }));

// Calculate stats
const watchingCount = anime.filter(a => a.data.status === 'watching').length;
const completedCount = anime.filter(a => a.data.status === 'completed').length;
const scoredCount = anime.filter(a => a.data.score && a.data.score > 0).length;
const top10Count = anime.filter(a => a.data.score === 10).length;
---

<BaseLayout
  title={pageTitle('Anime')}
  description="Anime I've watched"
>
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-4" style="color: var(--text-primary);">
        Anime
      </h1>
    </div>

    {anime.length > 0 && (
      <section class="mb-20">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-3xl font-bold" style="color: var(--text-primary);">
            My Anime List
          </h2>
          <span class="text-sm" style="color: var(--text-secondary);">
            {anime.length} {anime.length === 1 ? 'anime' : 'anime'}
          </span>
        </div>

        <AnimeFilter client:load anime={anime} />

        <StatGrid title="Viewing Stats" stats={[
          { value: completedCount, label: 'Completed' },
          { value: watchingCount, label: 'Watching' },
          { value: scoredCount, label: 'Scored' },
          { value: top10Count, label: 'Perfect 10s' },
        ]} />
      </section>
    )}

    {anime.length === 0 && (
      <LoadError thing="anime" />
    )}
  </div>
</BaseLayout>
