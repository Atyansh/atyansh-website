# Steam API Configuration
# Get your API key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here
STEAM_ID=your_steam_id_here

# PlayStation Network Configuration
# Get NPSSO token by following PSN authentication flow
PSN_NPSSO=your_psn_npsso_token_here

# IGDB (Internet Game Database) Configuration
# Used for high-quality game cover art across all platforms
# Get credentials at: https://api-docs.igdb.com/#account-creation
# Access token expires every ~60 days; build script auto-renews using client secret
IGDB_CLIENT_ID=your_twitch_client_id_here
IGDB_CLIENT_SECRET=your_twitch_client_secret_here
IGDB_ACCESS_TOKEN=your_twitch_access_token_here

# Spotify API Configuration
# Get credentials at: https://developer.spotify.com/dashboard
# Run scripts/get-spotify-token.cjs to get your refresh token
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here

# Goodreads Configuration
# Your Goodreads user ID - find it in your profile URL (e.g., goodreads.com/user/show/12345678)
GOODREADS_USER_ID=your_goodreads_user_id_here

# Letterboxd Configuration
# Your Letterboxd username - from your profile URL (e.g., letterboxd.com/username)
LETTERBOXD_USERNAME=your_letterboxd_username_here

# MyAnimeList Configuration (Official API)
# 1. Register an app at: https://myanimelist.net/apiconfig/create
# 2. Run: node scripts/get-mal-token.cjs to get your tokens
# Note: MAL_CLIENT_SECRET is only needed for the token generation script
# Token expires in ~745 hours (31 days)
MAL_CLIENT_ID=your_mal_client_id_here
MAL_CLIENT_SECRET=your_mal_client_secret_here
MAL_ACCESS_TOKEN=your_mal_access_token_here
MAL_REFRESH_TOKEN=your_mal_refresh_token_here

# Email Notification Configuration (for API Health Monitoring)
# Get Gmail app password at: https://myaccount.google.com/security
# 1. Enable 2-Factor Authentication
# 2. Go to "App passwords" and create one for "Mail"
# 3. Use the generated 16-character password (format: xxxx xxxx xxxx xxxx)
NOTIFICATION_EMAIL=your_email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
