---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedCard from '../components/AnimatedCard';
---

<BaseLayout
  title="Atyansh Jaiswal - Software Engineer"
  description="Software Engineer specializing in privacy infrastructure, security engineering, and large-scale abuse detection systems."
  structuredDataType="person"
>
  <!-- About Me -->
  <section class="mb-20 max-w-6xl mx-auto">
    <h2 class="text-4xl font-bold mb-12 text-center" style="color: var(--text-primary);">About Me</h2>

    <!-- Profile Section -->
    <div class="grid md:grid-cols-3 gap-8 mb-16">
      <AnimatedCard client:load delay={0} className="md:col-span-1">
        <div class="flex flex-col items-center text-center">
          <img
            src="https://www.gravatar.com/avatar/7e16fc57778ed552f69eb809ce567b38?s=512"
            alt="Atyansh Jaiswal"
            width="192"
            height="192"
            class="w-48 h-48 rounded-full mb-4 object-cover border-4"
            style="border-color: var(--accent);"
            loading="eager"
            decoding="async"
          />
          <h3 class="text-2xl font-bold mb-2" style="color: var(--text-primary);">Atyansh Jaiswal</h3>
          <p class="font-medium mb-4" style="color: var(--accent);">Software Engineer</p>
          <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-6">
            Specialized in privacy infrastructure, security engineering, and large-scale abuse detection systems.
          </p>

          <!-- Quick Stats -->
          <div class="w-full mb-6 p-4 rounded-lg" style="background-color: var(--bg-secondary);">
            <div class="flex items-center justify-center gap-2 text-sm mb-2" style="color: var(--text-secondary);">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>Bay Area, CA</span>
            </div>
            <div class="flex items-center justify-center gap-2 text-sm" style="color: var(--text-secondary);">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <span>10+ Years Experience</span>
            </div>
          </div>

          <!-- Social Links -->
          <div class="w-full mb-6">
            <h4 class="text-xs font-bold uppercase tracking-wider mb-3" style="color: var(--text-secondary);">Connect</h4>
            <div class="grid grid-cols-2 gap-2">
              <a
                href="https://github.com/atyansh"
                target="_blank"
                rel="noopener noreferrer"
                class="social-link flex items-center justify-center gap-2 px-3 py-2 text-white rounded-lg transition-colors text-xs"
                title="GitHub"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                GitHub
              </a>
              <a
                href="https://linkedin.com/in/atyansh"
                target="_blank"
                rel="noopener noreferrer"
                class="social-link flex items-center justify-center gap-2 px-3 py-2 text-white rounded-lg transition-colors text-xs"
                title="LinkedIn"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                LinkedIn
              </a>
              <a
                href="https://x.com/AtyanshJ"
                target="_blank"
                rel="noopener noreferrer"
                class="social-link flex items-center justify-center gap-2 px-3 py-2 text-white rounded-lg transition-colors text-xs"
                title="X (Twitter)"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
                X
              </a>
              <a
                href="https://instagram.com/atyansh"
                target="_blank"
                rel="noopener noreferrer"
                class="social-link flex items-center justify-center gap-2 px-3 py-2 text-white rounded-lg transition-colors text-xs"
                title="Instagram"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
                Instagram
              </a>
              <a
                href="mailto:atyansh.jaiswal@gmail.com"
                class="social-link flex items-center justify-center gap-2 px-3 py-2 text-white rounded-lg transition-colors text-xs col-span-2"
                title="Email"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
                  <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
                </svg>
                atyansh.jaiswal@gmail.com
              </a>
            </div>
          </div>

          <!-- Quick Actions -->
          <div class="w-full space-y-2">
            <a
              href="/resume.pdf"
              class="action-button-primary flex items-center justify-center gap-2 w-full px-4 py-3 text-white rounded-lg transition-colors font-medium text-sm"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              Resume
            </a>
            <a
              href="/pgp"
              class="action-button-secondary flex items-center justify-center gap-2 w-full px-4 py-2 border-2 rounded-lg transition-colors font-medium text-sm"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              PGP Key
            </a>
          </div>
        </div>
      </AnimatedCard>

      <div class="md:col-span-2 space-y-8">
        <!-- Work Experience -->
        <AnimatedCard client:load delay={0.1}>
          <h3 class="text-2xl font-bold mb-6 flex items-center gap-2" style="color: var(--text-primary);">
            <svg class="w-6 h-6" style="color: var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Work Experience
          </h3>
          <div class="space-y-6">
            <div class="border-l-4 pl-4" style="border-color: var(--accent);">
              <div class="flex justify-between items-start mb-2">
                <div>
                  <h4 class="font-bold text-lg text-gray-900 dark:text-white">Anthropic</h4>
                  <p class="text-gray-600 dark:text-gray-400">Member of Technical Staff</p>
                </div>
                <span class="text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">2025 - Present</span>
              </div>
              <p class="text-gray-600 dark:text-gray-300 text-sm">
                Building privacy-preserving infrastructure for AI systems.
              </p>
            </div>

            <div class="border-l-4 pl-4" style="border-color: var(--border);">
              <div class="flex justify-between items-start mb-2">
                <div>
                  <h4 class="font-bold text-lg text-gray-900 dark:text-white">ByteDance</h4>
                  <p class="text-gray-600 dark:text-gray-400">Senior Software Engineer</p>
                </div>
                <span class="text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">2024-2025</span>
              </div>
              <p class="text-gray-600 dark:text-gray-300 text-sm">
                Global Payments Security and Privacy. Detecting payment fraud, protecting APIs from web attacks and DDoS, building rule engine platform at the API Gateway layer.
              </p>
            </div>

            <div class="border-l-4 pl-4" style="border-color: var(--border);">
              <div class="flex justify-between items-start mb-2">
                <div>
                  <h4 class="font-bold text-lg text-gray-900 dark:text-white">Block</h4>
                  <p class="text-gray-600 dark:text-gray-400">Staff Software Engineer</p>
                </div>
                <span class="text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">2022-2024</span>
              </div>
              <p class="text-gray-600 dark:text-gray-300 text-sm">
                Privacy Engineering. Led Consent Management Framework, built cookie consent solutions across Web and Mobile, worked on data deletion and export systems for privacy compliance.
              </p>
            </div>

            <div class="border-l-4 pl-4" style="border-color: var(--border);">
              <div class="flex justify-between items-start mb-2">
                <div>
                  <h4 class="font-bold text-lg text-gray-900 dark:text-white">Meta</h4>
                  <p class="text-gray-600 dark:text-gray-400">Software Engineer</p>
                </div>
                <span class="text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">2017-2022</span>
              </div>
              <p class="text-gray-600 dark:text-gray-300 text-sm">
                Privacy Infrastructure and Messenger Privacy. Detecting and mitigating large-scale scraping attacks on Facebook and Instagram, building secure Messenger infrastructure, Privacy IMOC oncall.
              </p>
            </div>

            <div class="border-l-4 pl-4" style="border-color: var(--border);">
              <div class="mb-2">
                <h4 class="font-bold text-base text-gray-900 dark:text-white">Internships</h4>
              </div>
              <p class="text-gray-600 dark:text-gray-300 text-sm">
                <span class="font-medium">Meta:</span> Ads Signals & Ads Infrastructure (2015-2016)<br/>
                <span class="font-medium">Google:</span> YouTube Infrastructure (2015)<br/>
                <span class="font-medium">ViaSat:</span> Satellite Internet Analytics (2014)
              </p>
            </div>
          </div>
        </AnimatedCard>

        <!-- Education -->
        <AnimatedCard client:load delay={0.2}>
          <h3 class="text-2xl font-bold mb-6 flex items-center gap-2" style="color: var(--text-primary);">
            <svg class="w-6 h-6" style="color: var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M12 14l9-5-9-5-9 5 9 5z" />
              <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
            </svg>
            Education
          </h3>
          <div class="border-l-4 pl-4" style="border-color: var(--accent);">
            <div class="flex justify-between items-start mb-2">
              <div>
                <h4 class="font-bold text-lg text-gray-900 dark:text-white">UC San Diego</h4>
                <p class="text-gray-600 dark:text-gray-400">BS/MS in Computer Science</p>
              </div>
              <span class="text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">2012-2017</span>
            </div>
            <p class="text-gray-600 dark:text-gray-300 text-sm mb-2">
              Specialization in Computer Security, Systems, and Cryptography
            </p>
            <p class="text-gray-600 dark:text-gray-300 text-sm mb-2">
              Master's thesis: Analyzing and addressing security issues in non-browser web-connected applications
            </p>
            <div class="mt-3 pt-3 border-t border-gray-200 dark:border-gray-600">
              <p class="text-gray-600 dark:text-gray-300 text-sm mb-1">
                <span class="font-medium">Teaching Assistant (2016-2017):</span>
              </p>
              <ul class="list-disc list-inside text-gray-600 dark:text-gray-300 text-sm ml-2">
                <li>Intro to Computer Security: Control flow hijacking, MITM attacks, XSS, CSRF, JIT Spraying, SSL stripping, privacy</li>
                <li>Programming Language Theory: Haskell, lambda calculus, type inference, monads</li>
              </ul>
            </div>
            <div class="mt-3 pt-3 border-t border-gray-200 dark:border-gray-600">
              <p class="text-gray-600 dark:text-gray-300 text-sm">
                <span class="font-medium">Graduate Researcher:</span> Saber (Delegating Web Security to Browser), SPAM (Secure Package Manager)
              </p>
            </div>
          </div>
        </AnimatedCard>
      </div>
    </div>

  </section>
</BaseLayout>
