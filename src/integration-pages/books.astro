---
import { pageTitle } from '../site.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import BooksFilter from '../components/BooksFilter';
import StatGrid from '../components/StatGrid.astro';
import LoadError from '../components/LoadError.astro';
import { formatSiteDate, maybeDate } from '../components/formatDate';
import { getGoodreadsData } from '../utils/goodreads';

// Fetch Goodreads data at build time
const goodreadsData = await getGoodreadsData();

// No Goodreads data at all (fetch failed and no last-known-good copy) shows
// an error message below rather than a placeholder library
type Detail = { label: string; value: string };
const details = (...rows: Array<[string, string | number | undefined | false]>): Detail[] =>
  rows.filter(([, v]) => v !== undefined && v !== false && v !== '').map(([label, value]) => ({ label, value: String(value) }));
const STATUS_LABELS: Record<string, string> = { reading: 'Currently reading', finished: 'Finished', 'want-to-read': 'Want to read' };

// Card details are formatted here at build time. Goodreads publication dates
// are year-only (Jan 1, site time zone); "read" dates are timestamps (local day).
const books = (goodreadsData?.books ?? []).map(book => ({
  data: {
    title: book.title,
    author: book.author,
    coverImage: book.coverImage,
    rating: book.rating,
    status: book.status,
    publishedDate: book.publishedDate,
    details: details(
      ['Status', STATUS_LABELS[book.status] ?? book.status],
      ['Published', maybeDate(book.publishedDate) && formatSiteDate(book.publishedDate!, { year: 'numeric' })],
      ['Read', book.status === 'finished' && maybeDate(book.dateRead) && formatSiteDate(book.dateRead!)],
      ['Rating', book.rating ? `${book.rating}/5` : undefined],
    ),
  }
}));
---

<BaseLayout
  title={pageTitle('Books')}
  description="Books I'm reading and have read"
>
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-4" style="color: var(--text-primary);">
        Books
      </h1>
    </div>

    {books.length > 0 && (
      <section class="mb-20">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-3xl font-bold" style="color: var(--text-primary);">
            My Library
          </h2>
          <span class="text-sm" style="color: var(--text-secondary);">
            {books.length} {books.length === 1 ? 'book' : 'books'}
          </span>
        </div>

        <BooksFilter client:load books={books} />

        <StatGrid title="Reading Stats" stats={[
          { value: books.filter(b => b.data.status === 'finished').length, label: 'Finished' },
          { value: books.filter(b => b.data.status === 'reading').length, label: 'Currently Reading' },
          { value: books.filter(b => b.data.status === 'want-to-read').length, label: 'Want to Read' },
          { value: books.filter(b => b.data.rating === 5).length, label: '5-Star Reads' },
        ]} />
      </section>
    )}

    {books.length === 0 && (
      <LoadError thing="book" />
    )}
  </div>
</BaseLayout>
