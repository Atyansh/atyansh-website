---
// Static card with a CSS entrance animation. Server-rendered and never
// hydrated: content is fully visible without JavaScript, and the entrance /
// hover motion only runs when the visitor hasn't asked for reduced motion
// (see .animate-enter / .hover-lift in global.css).
interface Props {
  href?: string;
  className?: string;
  delay?: number;
}

const { href, className = '', delay = 0 } = Astro.props;
const enterDelay = `--enter-delay: ${delay}s;`;
const cardStyle = 'background-color: var(--bg-card); border-color: var(--border);';
---

{href ? (
  <div class="animate-enter h-full overflow-hidden md:overflow-visible" style={enterDelay}>
    <a
      href={href}
      class:list={[
        'block p-6 rounded-lg shadow-md border transition-transform motion-safe:hover:scale-[1.02] motion-safe:hover:-translate-y-1 overflow-hidden md:overflow-visible',
        className,
      ]}
      style={cardStyle}
    >
      <slot />
    </a>
  </div>
) : (
  <div
    class:list={['animate-enter hover-lift block p-6 rounded-lg shadow-md border overflow-hidden md:overflow-visible', className]}
    style={cardStyle + enterDelay}
  >
    <slot />
  </div>
)}
