---
import '../styles/global.css';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import StructuredData from '../components/StructuredData.astro';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  structuredDataType?: 'person' | 'article' | 'website' | 'blog';
  structuredData?: Record<string, any>;
}

const { title, description = "Software Engineer | Personal Website", image, type = "website", structuredDataType = "website", structuredData = {} } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Generate OG image URL
let ogImageURL: URL;
if (image) {
  ogImageURL = new URL(image, Astro.site);
} else {
  // Generate dynamic OG image
  const ogParams = new URLSearchParams({
    title: title.replace(' - Atyansh Jaiswal', '').replace(' - Blog', '').replace(' - Project', ''),
    description: description,
    type: type === 'article' ? 'blog' : 'default',
  });
  ogImageURL = new URL(`/og-image.png?${ogParams.toString()}`, Astro.site);
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Atyansh Jaiswal" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Security headers -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="DENY" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="geolocation=(), microphone=(), camera=()" />

    <!-- OpenGraph tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Atyansh Jaiswal" />

    <!-- Twitter Card tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@AtyanshJ" />
    <meta name="twitter:creator" content="@AtyanshJ" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- View Transitions for smooth page navigation -->
    <ViewTransitions />

    <script is:inline>
      // Run FIRST to set theme before ANY rendering
      (function() {
        const theme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = theme === 'dark' || (!theme && prefersDark);

        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <script>
      // Persist theme and data-theme across view transitions
      document.addEventListener('astro:before-swap', (e) => {
        // Preserve dark mode class
        const theme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = theme === 'dark' || (!theme && prefersDark);

        if (isDark) {
          e.newDocument.documentElement.classList.add('dark');
        } else {
          e.newDocument.documentElement.classList.remove('dark');
        }

        // Preserve data-theme attribute
        const savedTheme = localStorage.getItem('theme') || 'minimal-technical';
        e.newDocument.documentElement.setAttribute('data-theme', savedTheme);
      });

      // Suppress harmless WebSocket closed errors during View Transitions (dev only)
      if (import.meta.env.DEV) {
        const originalError = console.error;
        console.error = (...args) => {
          if (args[0]?.includes?.('WebSocket closed')) return;
          originalError.apply(console, args);
        };
      }
    </script>

    <!-- Structured Data -->
    <StructuredData type={structuredDataType} data={structuredData} />
  </head>
  <body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen flex flex-col">
    <!-- Skip to main content link for accessibility -->
    <a
      href="#main-content"
      class="skip-link sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 px-4 py-2 rounded-lg font-medium"
      style="background-color: var(--accent); color: white;"
    >
      Skip to main content
    </a>

    <header class="header-no-backdrop bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700" role="banner">
      <nav class="container mx-auto px-4 py-4" role="navigation" aria-label="Main navigation">
        <div class="flex items-center justify-between">
          <a href="/" class="text-2xl font-bold transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded whitespace-nowrap" style="color: var(--accent); outline-color: var(--accent);" onmouseover="this.style.color='var(--accent-hover)'" onmouseout="this.style.color='var(--accent)'" aria-label="Atyansh Jaiswal - Home">
            Atyansh Jaiswal
          </a>

          <!-- Desktop Navigation -->
          <div class="hidden lg:flex items-center gap-6">
            <ul class="flex gap-6 text-sm font-medium" role="list">
              <li><a href="/" class="transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-1" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to home page">Home</a></li>
              <li><a href="/work" class="transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-1" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to projects page">Projects</a></li>
              <li><a href="/books" class="transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-1" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to books page">Books</a></li>
              <li><a href="/music" class="transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-1" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to music page">Music</a></li>
              <li><a href="/movies" class="transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-1" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to movies page">Movies</a></li>
              <li><a href="/anime" class="transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-1" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to anime page">Anime</a></li>
              <li><a href="/games" class="transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-1" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to games page">Games</a></li>
              <li><a href="/climbing" class="transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-1" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to climbing page">Climbing</a></li>
              <li><a href="/pets" class="transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-1" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to pets page">Pets</a></li>
              <li><a href="/blog" class="transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-1" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to blog">Blog</a></li>
            </ul>
          </div>

          <!-- Right Side: Theme Switcher and Mobile Menu Button -->
          <div class="flex items-center gap-4">
            <ThemeSwitcher />
            <button id="mobile-menu-button" class="p-2 lg:hidden" aria-label="Toggle menu">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile Navigation -->
        <div id="mobile-menu" class="hidden lg:hidden mt-4">
          <ul class="flex flex-col gap-2 text-sm font-medium" role="list">
            <li><a href="/" class="block transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-2" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to home page">Home</a></li>
            <li><a href="/work" class="block transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-2" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to projects page">Projects</a></li>
            <li><a href="/books" class="block transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-2" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to books page">Books</a></li>
            <li><a href="/music" class="block transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-2" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to music page">Music</a></li>
            <li><a href="/movies" class="block transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-2" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to movies page">Movies</a></li>
            <li><a href="/anime" class="block transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-2" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to anime page">Anime</a></li>
            <li><a href="/games" class="block transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-2" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to games page">Games</a></li>
            <li><a href="/climbing" class="block transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-2" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to climbing page">Climbing</a></li>
            <li><a href="/pets" class="block transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-2" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to pets page">Pets</a></li>
            <li><a href="/blog" class="block transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 rounded px-2 py-2" style="outline-color: var(--accent);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color=''" aria-label="Navigate to blog">Blog</a></li>
          </ul>
        </div>
      </nav>
    </header>

    <script>
      function initMobileMenu() {
        const button = document.getElementById('mobile-menu-button');
        const menu = document.getElementById('mobile-menu');

        if (!button || !menu) return;

        button.addEventListener('click', () => {
          menu.classList.toggle('hidden');
        });
      }

      // Initialize on page load
      initMobileMenu();

      // Re-initialize after View Transitions
      document.addEventListener('astro:after-swap', initMobileMenu);
    </script>

    <main id="main-content" class="flex-1 container mx-auto px-4 py-8" role="main">
      <slot />
    </main>

    <footer class="bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 py-8 mt-auto" role="contentinfo">
      <div class="container mx-auto px-4">
        <div class="flex justify-center items-center">
          <div class="text-sm text-gray-600 dark:text-gray-400">
            &copy; {new Date().getFullYear()} Atyansh Jaiswal
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
