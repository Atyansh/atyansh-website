# Credentials and account ids/usernames, grouped by integration.
#
# Locally: copy to .env (gitignored). In Cloud Build every key lives in ONE
# Secret Manager secret, SITE_SECRETS (a flat JSON object of these keys).
# `node scripts/pull-secrets.cjs` fills .env from it (also run by
# `npm run build:fresh`); push edits back with
#   node scripts/push-secrets.cjs KEY ...   (naming a key adds it)
#
# Every integration is optional. It is ENABLED when its toggle in
# src/site.config.ts is on AND its REQUIRED keys below are set; otherwise its
# page, nav entry, sitemap entry and health check simply don't exist. Leave a
# whole group out (or delete the lines) to turn that integration off.
# Public presentation choices (site name, social links, analytics, time zone,
# featured Spotify playlists) are NOT here: they're in src/site.config.ts.

# ---------------------------------------------------------------------------
# Goodreads -> /books
# Required: GOODREADS_USER_ID, GOODREADS_COOKIE
# ---------------------------------------------------------------------------
# Your Goodreads user id, from your profile URL (goodreads.com/user/show/<id>)
GOODREADS_USER_ID=your_goodreads_user_id_here
# Whole Cookie header from a signed-in goodreads.com request (quote it).
# Renewed and re-saved by scripts/refresh-tokens.cjs every build
GOODREADS_COOKIE='your_goodreads_cookie_header_here'

# ---------------------------------------------------------------------------
# Spotify -> /music
# Required: SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET, SPOTIFY_REFRESH_TOKEN
# ---------------------------------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard, then run
# node scripts/get-spotify-token.cjs to get the refresh token
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here

# ---------------------------------------------------------------------------
# Letterboxd -> /movies (public profile scraping, no API key)
# Required: LETTERBOXD_USERNAME
# ---------------------------------------------------------------------------
# From your profile URL (letterboxd.com/<username>)
LETTERBOXD_USERNAME=your_letterboxd_username_here

# ---------------------------------------------------------------------------
# TMDB -> /tv
# Required: TMDB_ACCESS_TOKEN, TMDB_ACCOUNT_OBJECT_ID, TMDB_TV_LIST_ID
# Optional: TMDB_READ_TOKEN (only scripts/setup-tmdb.cjs uses it)
# ---------------------------------------------------------------------------
# 1. Get the API Read Access Token at: https://www.themoviedb.org/settings/api
# 2. Run: node scripts/setup-tmdb.cjs to authorize and get the remaining values
# The access token is long-lived — no refresh needed
TMDB_READ_TOKEN=your_tmdb_read_access_token_here
TMDB_ACCESS_TOKEN=your_tmdb_user_access_token_here
TMDB_ACCOUNT_OBJECT_ID=your_tmdb_account_object_id_here
TMDB_TV_LIST_ID=your_tmdb_list_id_here

# ---------------------------------------------------------------------------
# MyAnimeList -> /anime (official API)
# Required: MAL_CLIENT_ID, MAL_ACCESS_TOKEN
# Optional: MAL_CLIENT_SECRET, MAL_REFRESH_TOKEN (auto-refresh every build)
# ---------------------------------------------------------------------------
# 1. Register an app at: https://myanimelist.net/apiconfig/create
# 2. Run: node scripts/get-mal-token.cjs to get your tokens
# Access token expires in ~745 hours (31 days); refresh-tokens.cjs renews it
# when the secret and refresh token are set
MAL_CLIENT_ID=your_mal_client_id_here
MAL_CLIENT_SECRET=your_mal_client_secret_here
MAL_ACCESS_TOKEN=your_mal_access_token_here
MAL_REFRESH_TOKEN=your_mal_refresh_token_here

# ---------------------------------------------------------------------------
# Games -> /games (generated when ANY of Steam / PlayStation / Nintendo is on)
# ---------------------------------------------------------------------------
# Steam. Required: STEAM_API_KEY, STEAM_ID
# Get your API key at: https://steamcommunity.com/dev/apikey
# STEAM_ID is your 64-bit Steam id (profile must be public)
STEAM_API_KEY=your_steam_api_key_here
STEAM_ID=your_steam_id_here

# PlayStation Network. Required: PSN_NPSSO or PSN_REFRESH_TOKEN
# NPSSO bootstraps the refresh token. After the first build, builds use
# PSN_REFRESH_TOKEN (rotates every build, ~10-day window) so the NPSSO can go
# stale without breaking the site. The refresh token and its expiry are
# written by scripts/refresh-tokens.cjs.
# To get a new NPSSO: log out + log back in at playstation.com, then visit
# https://ca.account.sony.com/api/v1/ssocookie
PSN_NPSSO=your_psn_npsso_token_here
PSN_REFRESH_TOKEN=
PSN_REFRESH_TOKEN_EXPIRES_AT=0

# Nintendo Switch, via Exophase (public profile scraping).
# Required: EXOPHASE_USERNAME, from your profile URL (exophase.com/user/<username>)
EXOPHASE_USERNAME=your_exophase_username_here

# IGDB (Internet Game Database): cover art for the games above. Optional
# enhancer: without it, cards use the platforms' own images.
# Required: IGDB_CLIENT_ID, IGDB_CLIENT_SECRET. Optional: IGDB_ACCESS_TOKEN
# Get credentials at: https://api-docs.igdb.com/#account-creation (a Twitch app)
# The access token expires every ~60 days; refresh-tokens.cjs mints a new one
# from the client secret
IGDB_CLIENT_ID=your_twitch_client_id_here
IGDB_CLIENT_SECRET=your_twitch_client_secret_here
IGDB_ACCESS_TOKEN=your_twitch_access_token_here

# ---------------------------------------------------------------------------
# Kaya -> /climbing
# Required: KAYA_USERNAME. Optional: KAYA_REFRESH_TOKEN
# ---------------------------------------------------------------------------
# Your Kaya username - from your profile in the app
KAYA_USERNAME=your_kaya_username_here
# Refresh token for the logged-in ascents query (the public one is capped at
# 200 results). Must come from Firefox on a Mac — Kaya binds it to the browser:
#   1. Sign in at https://kaya-app.kayaclimb.com in Firefox on macOS
#   2. DevTools console: copy(localStorage.getItem('refresh_token'))
# Long-lived and reused every build (never rotated). Signing out of that
# session likely revokes it. Without it, ascents come from the capped public
# queries; with it, the health check also watches the logged-in fetch.
KAYA_REFRESH_TOKEN=your_kaya_refresh_token_here

# ---------------------------------------------------------------------------
# Discord build/API-health alerts (scripts/check-api-health.cjs). Optional:
# without them the health check only writes its report.
# ---------------------------------------------------------------------------
# 1. Create a bot at: https://discord.com/developers/applications
# 2. Copy the bot token from the Bot settings page
# 3. Invite the bot to a server you're in (it needs to share a server with you to DM)
# 4. To get your Discord user ID: enable Developer Mode in Discord settings,
#    then right-click your name and "Copy User ID"
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_USER_ID=your_discord_user_id_here

# ---------------------------------------------------------------------------
# Google Cloud project holding SITE_SECRETS (optional). Cloud Build sets
# GOOGLE_CLOUD_PROJECT itself; locally the scripts fall back to
# `gcloud config get-value project`. Set this only to override both.
# ---------------------------------------------------------------------------
# SITE_GCP_PROJECT=your-project-id
