---
import { pageTitle } from '../site.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCarousel from '../components/GameCarousel';
import LoadError from '../components/LoadError.astro';
import type { GameCardData } from '../components/GameCard';
import { formatSiteDate } from '../components/formatDate';
import { getAllGames, getPlatformName, getPlatformColor, type UnifiedGame } from '../utils/unified-games';
import { getGameCapsuleFallbacks } from '../utils/steam';
import { enabledIntegrations } from '../integrations';

// Fetch all games and stats from the enabled platforms in a single call
const enabled = enabledIntegrations();
const sources = {
  steam: enabled.has('steam'),
  psn: enabled.has('psn'),
  nintendo: enabled.has('nintendo'),
  igdb: enabled.has('igdb'),
};
const { games: allGames, steamStats, psnStats, nintendoStats } = await getAllGames(sources);

// "Steam, PlayStation, and Nintendo Switch" (only the enabled platforms)
const platformNames = (['steam', 'psn', 'nintendo'] as const).filter(p => sources[p]).map(getPlatformName);
const platformList = platformNames.length <= 2
  ? platformNames.join(' and ')
  : `${platformNames.slice(0, -1).join(', ')}, and ${platformNames[platformNames.length - 1]}`;

// Last-played dates are formatted here, at build time, in the site time zone and
// passed to the cards as strings: formatting in the hydrated card would
// re-run in the visitor's time zone and mismatch the server HTML
const lastPlayed = (date: number | string) => formatSiteDate(date, { month: 'numeric', day: 'numeric', year: 'numeric' });

function toCardData(game: UnifiedGame): GameCardData {
  const stats: GameCardData['stats'] = [];
  let trophies: GameCardData['trophies'];
  if (game.steamData) {
    stats.push({ label: 'Playtime', value: `${Math.floor(game.steamData.playtimeMinutes / 60)}h` });
    if (game.steamData.lastPlayed && game.steamData.lastPlayed > 0) {
      stats.push({ label: 'Last Played', value: lastPlayed(game.steamData.lastPlayed * 1000) });
    }
  }
  if (game.psnData) {
    if (game.psnData.playDuration) stats.push({ label: 'Playtime', value: game.psnData.playDuration });
    if (game.psnData.trophies && game.psnData.trophies.total > 0) {
      const { platinum, gold, silver, bronze } = game.psnData.trophies;
      trophies = { platinum, gold, silver, bronze };
    }
    if (game.psnData.lastPlayed) stats.push({ label: 'Last Played', value: lastPlayed(game.psnData.lastPlayed) });
  }
  if (game.nintendoData) {
    stats.push({ label: 'Playtime', value: `${Math.floor(game.nintendoData.playtimeSeconds / 3600)}h` });
    if (game.nintendoData.lastPlayed) stats.push({ label: 'Last Played', value: lastPlayed(game.nintendoData.lastPlayed) });
  }
  const fallbackImages = game.steamData ? getGameCapsuleFallbacks(game.steamData.appid) : [];
  return {
    id: game.id,
    name: game.name,
    image: game.image || fallbackImages[0] || '',
    fallbackImages: game.image ? fallbackImages : fallbackImages.slice(1),
    platformName: getPlatformName(game.platform),
    platformColor: getPlatformColor(game.platform),
    stats,
    trophies,
  };
}

// Pre-compute platform game lists (only the fields the cards render)
const steamGames = allGames.filter(g => g.platform === 'steam').map(toCardData);
const psnGames = allGames.filter(g => g.platform === 'psn').map(toCardData);
const nintendoGames = allGames.filter(g => g.platform === 'nintendo').map(toCardData);

// The Steam status is a build-time snapshot (and the Steam cache can be up to
// a day older than the build), so it is labelled as such rather than "currently"
const buildDate = formatSiteDate(Date.now());
---

<BaseLayout
  title={pageTitle('Games')}
  description={`Games I'm playing across ${platformList}`}
>
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-4" style="color: var(--text-primary);">
        Games
      </h1>
    </div>

    {allGames.length > 0 && (
      <section class="mb-20">
        {/* Steam Status Banner */}
        {steamStats && steamStats.playerSummary.gameextrainfo && (
          <div class="mb-8 p-6 rounded-lg border-2" style="background-color: var(--bg-secondary); border-color: var(--accent);">
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-full motion-safe:animate-pulse" style="background-color: var(--accent);"></div>
              <div>
                <div class="text-sm font-medium" style="color: var(--text-secondary);">
                  Last seen playing on Steam <span class="whitespace-nowrap">(as of the {buildDate} site update)</span>
                </div>
                <div class="text-xl font-bold" style="color: var(--text-primary);">{steamStats.playerSummary.gameextrainfo}</div>
              </div>
            </div>
          </div>
        )}

        {/* Steam Games */}
        {steamStats && steamGames.length > 0 && (
          <div class="mb-12 p-6 rounded-lg" style="background-color: var(--bg-secondary);">
            <div class="flex flex-col lg:flex-row gap-8">
              <div class="lg:w-64 flex-shrink-0">
                <h3 class="text-xl font-bold mb-4" style="color: var(--text-primary);">Steam</h3>
                <div class="space-y-4">
                  <div>
                    <div class="text-3xl font-bold" style="color: var(--accent);">
                      {steamStats.totalGames}
                    </div>
                    <div class="text-sm" style="color: var(--text-secondary);">Total Games</div>
                  </div>
                  <div>
                    <div class="text-3xl font-bold" style="color: var(--accent);">
                      {steamStats.totalHoursPlayed.toLocaleString()}h
                    </div>
                    <div class="text-sm" style="color: var(--text-secondary);">Hours Played</div>
                  </div>
                  <div>
                    <div class="text-3xl font-bold" style="color: var(--accent);">
                      {steamStats.gamesPlayedCount}
                    </div>
                    <div class="text-sm" style="color: var(--text-secondary);">Games Played</div>
                  </div>
                </div>
              </div>
              <div class="flex-1 min-w-0">
                <GameCarousel
                  client:visible
                  games={steamGames}
                  title="Recent Games"
                />
              </div>
            </div>
          </div>
        )}

        {/* PlayStation Games */}
        {psnStats && psnGames.length > 0 && (
          <div class="mb-12 p-6 rounded-lg" style="background-color: var(--bg-secondary);">
            <div class="flex flex-col lg:flex-row gap-8">
              <div class="lg:w-64 flex-shrink-0">
                <h3 class="text-xl font-bold mb-4" style="color: var(--text-primary);">PlayStation</h3>
                <div class="space-y-4">
                  <div>
                    <div class="text-3xl font-bold" style="color: var(--accent);">
                      {psnStats.totalGames}
                    </div>
                    <div class="text-sm" style="color: var(--text-secondary);">Total Games</div>
                  </div>
                  {psnStats.trophyLevel && (
                    <div>
                      <div class="text-3xl font-bold" style="color: var(--accent);">
                        {psnStats.trophyLevel}
                      </div>
                      <div class="text-sm" style="color: var(--text-secondary);">Trophy Level</div>
                    </div>
                  )}
                  <div>
                    <div class="text-3xl font-bold" style="color: var(--accent);">
                      {psnStats.totalTrophies.total.toLocaleString()}
                    </div>
                    <div class="text-sm" style="color: var(--text-secondary);">Total Trophies</div>
                  </div>

                  {/* Trophy Breakdown */}
                  {psnStats.totalTrophies.total > 0 && (
                    <div class="pt-4 border-t" style="border-color: var(--bg-primary);">
                      <div class="space-y-2 text-sm" style="color: var(--text-primary);">
                        {psnStats.totalTrophies.platinum > 0 && (
                          <div class="flex items-center justify-between">
                            <span>🏆 Platinum</span>
                            <span class="font-bold">{psnStats.totalTrophies.platinum}</span>
                          </div>
                        )}
                        {psnStats.totalTrophies.gold > 0 && (
                          <div class="flex items-center justify-between">
                            <span>🥇 Gold</span>
                            <span class="font-bold">{psnStats.totalTrophies.gold}</span>
                          </div>
                        )}
                        {psnStats.totalTrophies.silver > 0 && (
                          <div class="flex items-center justify-between">
                            <span>🥈 Silver</span>
                            <span class="font-bold">{psnStats.totalTrophies.silver}</span>
                          </div>
                        )}
                        {psnStats.totalTrophies.bronze > 0 && (
                          <div class="flex items-center justify-between">
                            <span>🥉 Bronze</span>
                            <span class="font-bold">{psnStats.totalTrophies.bronze}</span>
                          </div>
                        )}
                      </div>
                    </div>
                  )}
                </div>
              </div>
              <div class="flex-1 min-w-0">
                <GameCarousel
                  client:visible
                  games={psnGames}
                  title="Recent Games"
                />
              </div>
            </div>
          </div>
        )}

        {/* Nintendo Games */}
        {nintendoStats && nintendoGames.length > 0 && (
          <div class="mb-12 p-6 rounded-lg" style="background-color: var(--bg-secondary);">
            <div class="flex flex-col lg:flex-row gap-8">
              <div class="lg:w-64 flex-shrink-0">
                <h3 class="text-xl font-bold mb-4" style="color: var(--text-primary);">Nintendo Switch</h3>
                <div class="space-y-4">
                  <div>
                    <div class="text-3xl font-bold" style="color: var(--accent);">
                      {nintendoStats.totalGames}
                    </div>
                    <div class="text-sm" style="color: var(--text-secondary);">Total Games</div>
                  </div>
                  <div>
                    <div class="text-3xl font-bold" style="color: var(--accent);">
                      {nintendoStats.totalHoursPlayed.toLocaleString()}h
                    </div>
                    <div class="text-sm" style="color: var(--text-secondary);">Hours Played</div>
                  </div>
                </div>
              </div>
              <div class="flex-1 min-w-0">
                <GameCarousel
                  client:visible
                  games={nintendoGames}
                  title="Recent Games"
                />
              </div>
            </div>
          </div>
        )}
      </section>
    )}

    {allGames.length === 0 && <LoadError thing="game" />}
  </div>
</BaseLayout>
